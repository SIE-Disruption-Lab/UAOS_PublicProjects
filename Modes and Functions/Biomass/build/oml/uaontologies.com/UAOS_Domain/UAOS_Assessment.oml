@dc:creator "SIE Disruption Lab"
@dc:contributor "Joe Gregory"
@dc:contributor "Paul Wach"
@dc:description "A vocabulary to capture T&E assessment patterns, including program review milestones, assessment findings, and DT/OT credit criteria."
@dc:hasVersion "0.1"
vocabulary <http://uaontologies.com/UAOS_Domain/UAOS_Assessment#> as UAOS_Assessment {

	////////////////////////////////////////////////////////////////////////////////////

	/////// Vocabulary Imports ///////

	// Import standard vocabularies
    extends <http://purl.org/dc/elements/1.1/> as dc
    extends <http://www.w3.org/2000/01/rdf-schema#> as rdfs
    extends <http://www.w3.org/2001/XMLSchema#> as xsd

    // Import relevant vocabularies
    extends <http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#> as tlo
	extends <http://uaontologies.com/UAOS_Core/UAOS_Information#> as info
	extends <http://uaontologies.com/UAOS_Domain/UAOS_Verification#> as ver
	extends <http://uaontologies.com/UAOS_Domain/UAOS_Test#> as test

	///////////////////////////////////////////////////////////////////////////////////


	/////// Vocabulary Definitions ///////


	///// Aspects


	///// Concepts

	@rdfs:label "Program Milestone"
	@dc:description "A [=ProgramMilestone=] is a Process constituting a formal program review gate at which readiness to proceed to the next acquisition or T&E phase is assessed. Examples include System Functional Review (SFR), Preliminary Design Review (PDR), Critical Design Review (CDR), Integrated Test Readiness Assessment (ITRA), and Milestone decisions (MS-A, MS-B, MS-C, FRP). ProgramMilestone is a Process because it is an event that unfolds over time and has participating reviewers and artefacts."
	concept ProgramMilestone < tlo:Process

	@rdfs:label "Assessment Finding"
	@dc:description "An [=AssessmentFinding=] is a PrescriptiveICE that prescribes a recommended action or records a significant judgement arising from a program review or T&E assessment. It may carry a confidence score when generated analytically or by AI-assisted assessment tools. The text of the finding is captured via tlo:hasNaturalLanguageDescription."
	concept AssessmentFinding < info:PrescriptiveICE

	@rdfs:label "DTOT Credit Criterion"
	@dc:description "A [=DTOTCreditCriterion=] is a PrescriptiveICE that specifies one of the criteria by which developmental test (DT) data may be credited toward operational test (OT) evaluation. The six canonical criteria (DTOT-01 through DTOT-06) address scenario realism, operator involvement, production configuration, data independence, pre-agreed protocols, and statistical adequacy."
	concept DTOTCreditCriterion < info:PrescriptiveICE


	///////////////////////////////////////////////////////////////////////////////////


	/////// Relations ///////

	@rdfs:label "Traces To Milestone"
	@dc:description "[=TracesToMilestone=] relates a VerificationActivity (including Tests, Inspections, Demonstrations, and Analyses) to the ProgramMilestone toward which its results contribute. Establishes the traceability link between individual test events and the program review gate they support."
	relation entity TracesToMilestone [
		from ver:VerificationActivity
		to ProgramMilestone
		@rdfs:label "traces to milestone"
		forward tracesToMilestone
		@rdfs:label "milestone traced to by"
		reverse milestoneTracedToBy
		asymmetric
		irreflexive
	]

	@rdfs:label "Has Finding"
	@dc:description "[=HasFinding=] relates a ProgramMilestone to an AssessmentFinding that arises from its review — capturing the recommendations and significant judgements recorded at that gate."
	relation entity HasFinding [
		from ProgramMilestone
		to AssessmentFinding
		@rdfs:label "has finding"
		forward hasFinding
		@rdfs:label "finding of"
		reverse findingOf
		asymmetric
		irreflexive
	]

	@rdfs:label "Satisfies DTOT Criterion"
	@dc:description "[=SatisfiesDTOTCriterion=] relates a Test to a DTOTCreditCriterion that it satisfies, recording which DT/OT integration criteria are met by a given test event."
	relation entity SatisfiesDTOTCriterion [
		from test:Test
		to DTOTCreditCriterion
		@rdfs:label "satisfies DTOT criterion"
		forward satisfiesDTOTCriterion
		@rdfs:label "DTOT criterion satisfied by"
		reverse dtotCriterionSatisfiedBy
		asymmetric
		irreflexive
	]


	///////////////////////////////////////////////////////////////////////////////////


	/////// Scalar Properties ///////

	@rdfs:label "confidence score"
	@dc:description "[=confidenceScore=] captures the analytical or AI-generated confidence in an AssessmentFinding, expressed as a value in [0.0, 1.0] where 1.0 indicates maximum confidence."
	scalar property confidenceScore [
		domain AssessmentFinding
		range xsd:double
	]


	///// Rules


}
