@dc:creator "SIE Disruption Lab"
@dc:contributor "Joe Gregory"
@dc:description "A vocabulary to capture manufacturing information"
@dc:hasVersion "0.1"
vocabulary <http://uaontologies.com/UAOS_Domain/UAOS_Manufacturing#> as UAOS_Manuf_I {
	
	////////////////////////////////////////////////////////////////////////////////////
	
	/////// Vocabulary Imports ///////
		
	// Import standard vocabularies	
    extends <http://purl.org/dc/elements/1.1/> as dc
    
    // Import relevant vocabularies
    extends <http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#> as tlo
	extends <http://uaontologies.com/UAOS_Core/UAOS_Information#> as info
	extends <http://uaontologies.com/UAOS_Core/UAOS_Agent#> as agent
	extends <http://uaontologies.com/UAOS_Core/UAOS_Event#> as event
	extends <http://uaontologies.com/UAOS_Core/UAOS_Measurement#> as meas
	
	///////////////////////////////////////////////////////////////////////////////////
	
	
	/////// Vocabulary Definitions ///////
	
	///// Aspects
	
			
	
	///// Concepts
	
	// P-Features
	
	concept PFeature < tlo:Quality, tlo:SDCCarrier [
		restricts some tlo:sdo to tlo:MaterialEntity
		restricts all tlo:sdo to tlo:MaterialEntity
	]
	
	concept FormPFeature < PFeature
	
	concept VoidFormPFeature < FormPFeature
	
	concept Hole < VoidFormPFeature
	
	concept BlindHole < Hole
	
	concept ThroughHole < Hole
	
	concept CompoundHole < Hole
	
	concept Slot < VoidFormPFeature
	
	concept MaterialFormPFeature < FormPFeature
	
	concept Protrusion < MaterialFormPFeature
	
	concept Bend < MaterialFormPFeature
	
	concept ManufacturingPFeature < PFeature
	
	concept MachiningPFeature < ManufacturingPFeature
	
	concept 2.5DFeature < MachiningPFeature
	
	concept 1DFeature < MachiningPFeature
	
	concept DeformationPFeature < ManufacturingPFeature
	
	concept AdditivePFeature < ManufacturingPFeature
	
	concept JointPFeature < ManufacturingPFeature
	
	concept Weld < JointPFeature
	
	concept WeldSize < meas:Quantity [
		restricts some tlo:sdo to Weld
	]
	
	concept WeldIntermittance < meas:Quantity [
		restricts some tlo:sdo to Weld
	]
	
	concept WeldFinish < meas:Quantity [
		restricts some tlo:sdo to Weld
	]
	
	concept ShapeQuality < tlo:Quality [
		restricts some tlo:sdo to FormPFeature
		restricts all tlo:sdo to FormPFeature
	]
	
	concept Blind < ShapeQuality [
		restricts some tlo:sdo to BlindHole
		restricts all tlo:sdo to BlindHole
	]
	
	concept Through < ShapeQuality [
		restricts some tlo:sdo to ThroughHole
		restricts all tlo:sdo to ThroughHole
	]
	
	
	// I-Features
	
	concept IFeature < info:DescriptiveICE [
		restricts some info:describes to PFeature
		restricts all info:describes to PFeature
	]
	
	concept WeldSymbol < IFeature [
		restricts some info:describes to Weld
		restricts all info:describes to Weld
		restricts some tlo:hasContinuantPart to WeldSymbol_WeldSize
		restricts some tlo:hasContinuantPart to WeldSymbol_WeldIntermittance
		restricts some tlo:hasContinuantPart to WeldSymbol_WeldFinish
	]
	
	concept WeldSymbol_WeldSize < meas:SimpleMeasurement [
		restricts some meas:measurementOf to WeldSize
	]
	
	concept WeldSymbol_WeldIntermittance < meas:SimpleMeasurement [
		restricts some meas:measurementOf to WeldIntermittance
	]
	
	concept WeldSymbol_WeldFinish < meas:SimpleMeasurement [
		restricts some meas:measurementOf to WeldFinish
	]
	
	
	// Processes
	
	concept ManufacturingCapability < tlo:Disposition [
		restricts some tlo:sdo to agent:Agent
		restricts all tlo:sdo to agent:Agent
		restricts all event:manifestsIn to tlo:Process
	]
	
	concept ProductProductionProcess < tlo:Process
	
	concept ManufacturingOperation < tlo:Process [
		restricts all tlo:hasOccurrentPart to ProductProductionProcess
	]
	
	concept ManufacturingProcess < tlo:Process [
		restricts all tlo:hasOccurrentPart to ManufacturingOperation
	]
	
	concept WeldingProcess < ManufacturingProcess [
		restricts some agent:hasOutput to Weld
	]
	
	concept WeldingCapability < ManufacturingCapability [
		restricts some tlo:hsd to MinWeldSize
		restricts some tlo:hsd to MaxWeldSize
		restricts some tlo:hsd to MinWeldFinish
	]
	
	concept MinWeldSize < meas:Quantity
	
	concept MaxWeldSize < meas:Quantity
	
	concept MinWeldFinish < meas:Quantity
	
}