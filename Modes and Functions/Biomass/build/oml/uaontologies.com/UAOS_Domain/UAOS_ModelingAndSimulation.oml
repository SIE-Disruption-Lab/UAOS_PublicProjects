@dc:creator "SIE Disruption Lab"
@dc:contributor "Joe Gregory"
@dc:description "A vocabulary to capture modeling and simulation patterns"
@dc:hasVersion "0.1"
vocabulary <http://uaontologies.com/UAOS_Domain/UAOS_ModelingAndSimulation#> as UAOS_ModelingAndSimulation {
	
	////////////////////////////////////////////////////////////////////////////////////
	
	/////// Vocabulary Imports ///////
	
	// Import standard vocabularies	
    extends <http://purl.org/dc/elements/1.1/> as dc
    extends <http://www.w3.org/2000/01/rdf-schema#> as rdfs
    
    // Import relevant vocabularies
    extends <http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#> as tlo
    extends <http://uaontologies.com/UAOS_Core/UAOS_Information#> as info
	extends <http://uaontologies.com/UAOS_Core/UAOS_Agent#> as agent
	extends <http://uaontologies.com/UAOS_Core/UAOS_Event#> as event
	extends <http://uaontologies.com/UAOS_Domain/UAOS_Verification#> as ver
		
	///////////////////////////////////////////////////////////////////////////////////
	
	
	/////// Vocabulary Definitions ///////
	
	///// Aspects
	
			
	
	///// Concepts
	
	@rdfs:label "Model"
	@dc:description "A [=Model=] is a..."
	concept Model < info:InformationArtifact [
		restricts some tlo:hgd to info:RepresentationalICE
	]	
	
	@rdfs:label "Analysis"
	@dc:description "A [=Analysis=] is a..."
	concept Analysis < agent:ManagedProcess, ver:VerificationActivity [
		restricts all agent:hasOutput to info:DescriptiveICE
	]
	
	@rdfs:label "Simulation"
	@dc:description "A [=Simulation=] is a..."
	concept Simulation < Analysis [
		restricts some event:hasParticipant to Model
	]

	
	
	
	///// Relations
	
	
	
	///// Scalar Properties
	
	
	
	///// Rules	
	
	

	
	
	}