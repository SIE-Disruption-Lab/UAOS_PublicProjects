@dc:creator "SIE Disruption Lab"
@dc:contributor "Joe Gregory"
@dc:description "Extended provenance vocabulary for the UAOS. Conforms to the PROV-O to BFO mapping (Prudhomme et al. 2025). Adds derivation chains, process-level attribution, and version tracking needed for digital thread traceability."
@dc:hasVersion "0.2"
vocabulary <http://uaontologies.com/UAOS_Core/UAOS_Provenance#> as UAOS_Prov {

	////////////////////////////////////////////////////////////////////////////////////

	/////// Vocabulary Imports ///////

	// Import standard vocabularies
    extends <http://purl.org/dc/elements/1.1/> as dc
    extends <http://www.w3.org/2000/01/rdf-schema#> as rdfs
    extends <http://www.w3.org/2001/XMLSchema#> as xsd

    // Import relevant vocabularies
    extends <http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#> as tlo
	extends <http://uaontologies.com/UAOS_Core/UAOS_Information#> as info
	extends <http://uaontologies.com/UAOS_Core/UAOS_Agent#> as agent

	///////////////////////////////////////////////////////////////////////////////////


	/////// Vocabulary Definitions ///////

	///// Aspects


	///// Concepts


	///// Relations

	@rdfs:label "Generated By"
	@dc:description "[=GeneratedBy=] relates an InformationArtifact to the Agent who produced it. Maps to prov:wasAttributedTo in the PROV-O/BFO alignment."
	relation entity GeneratedBy [
		from info:InformationArtifact
		to agent:Agent
		@rdfs:label "generated by"
		forward generatedBy
		@rdfs:label "generates"
		reverse generates
		asymmetric
		irreflexive
	]

	@rdfs:label "Approved By"
	@dc:description "[=ApprovedBy=] relates an InformationArtifact to the Agent who authorised it."
	relation entity ApprovedBy [
		from info:InformationArtifact
		to agent:Agent
		@rdfs:label "approved by"
		forward approvedBy
		@rdfs:label "approves"
		reverse approves
		asymmetric
		irreflexive
	]

	@rdfs:label "Was Derived From"
	@dc:description "[=WasDerivedFrom=] relates a derived InformationArtifact to the source artifact from which it was produced. Maps to prov:wasDerivedFrom. Critical for digital thread lineage."
	relation entity WasDerivedFrom [
		from info:InformationArtifact
		to info:InformationArtifact
		@rdfs:label "was derived from"
		forward wasDerivedFrom
		@rdfs:label "is source of"
		reverse isSourceOf
		asymmetric
		irreflexive
	]

	@rdfs:label "Was Generated By Process"
	@dc:description "[=WasGeneratedByProcess=] relates an InformationArtifact to the Process that produced it. Maps to prov:wasGeneratedBy (Activity sense), aligned to BFO 'participates in (at some time)'."
	relation entity WasGeneratedByProcess [
		from info:InformationArtifact
		to tlo:Process
		@rdfs:label "was generated by process"
		forward wasGeneratedByProcess
		@rdfs:label "generates artifact"
		reverse generatesArtifact
		asymmetric
		irreflexive
	]

	@rdfs:label "Used"
	@dc:description "[=Used=] relates a Process to an InformationArtifact it consumed as input. Maps to prov:used, aligned to BFO 'has participant (at some time)'."
	relation entity Used [
		from tlo:Process
		to info:InformationArtifact
		@rdfs:label "used"
		forward used
		@rdfs:label "was used by"
		reverse wasUsedBy
		asymmetric
		irreflexive
	]

	@rdfs:label "Was Associated With"
	@dc:description "[=WasAssociatedWith=] relates a Process to an Agent that was responsible for it. Maps to prov:wasAssociatedWith, aligned to BFO 'has participant (at some time)'."
	relation entity WasAssociatedWith [
		from tlo:Process
		to agent:Agent
		@rdfs:label "was associated with"
		forward wasAssociatedWith
		@rdfs:label "was associated with process"
		reverse wasAssociatedWithProcess
		asymmetric
		irreflexive
	]


	///// Scalar Properties

	@rdfs:label "generated at"
	@dc:description "[=generatedAt=] records the timestamp at which an artifact was produced."
	scalar property generatedAt [
		domain info:InformationArtifact
		range xsd:dateTime
	]

	@rdfs:label "approved at"
	@dc:description "[=approvedAt=] records the timestamp at which an artifact was approved."
	scalar property approvedAt [
		domain info:InformationArtifact
		range xsd:dateTime
	]

	@rdfs:label "had version"
	@dc:description "[=hadVersion=] records a version identifier for an InformationArtifact."
	scalar property hadVersion [
		domain info:InformationArtifact
		range xsd:string
	]

	@rdfs:label "was invalidated at time"
	@dc:description "[=wasInvalidatedAtTime=] records when an artifact was superseded or invalidated."
	scalar property wasInvalidatedAtTime [
		domain info:InformationArtifact
		range xsd:dateTime
	]


	///// Rules

	@rdfs:comment "If a role is responsible for a process that produces an artifact, then the agent who plays that role generated the artifact."
	rule Agent_with_role_generates_artifact [
		agent:responsibleFor(a, b) & agent:hasOutput(b, c) & agent:hasRole(d, a) -> generatedBy(c, d)
	]

	@rdfs:comment "If an artifact was generated by a process, and an agent was associated with that process, then the agent generated the artifact."
	rule Process_attribution_to_agent [
		wasGeneratedByProcess(a, b) & wasAssociatedWith(b, c) -> generatedBy(a, c)
	]

	@rdfs:comment "Derivation is transitive: if C was derived from B and B from A, then C was derived from A."
	rule Derivation_transitivity [
		wasDerivedFrom(a, b) & wasDerivedFrom(b, c) -> wasDerivedFrom(a, c)
	]


}
