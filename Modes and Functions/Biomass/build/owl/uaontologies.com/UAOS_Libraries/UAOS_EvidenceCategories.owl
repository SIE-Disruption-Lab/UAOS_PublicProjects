        <oml:namespace rdf:resource="http://uaontologies.com/UAOS_Libraries/UAOS_EvidenceCategories#"/>
        <oml:prefix>UAOS_EvidenceCategories</oml:prefix>
        <oml:type rdf:resource="http://opencaesar.io/oml#Description"/>
        <dc:contributor>Joe Gregory</dc:contributor>
        <dc:creator>SIE Disruption Lab</dc:creator>
        <dc:description>A library description defining the nine canonical instances of EvidenceQualityCategory for the D1 Evidence Quality axis of the 4D Assessment framework (EQ-0 through EQ-8). EQ-0 represents no usable evidence; EQ-8 represents the highest-quality operational evidence. The D1 scale is non-monotonic: evidence quality can regress if evidence becomes outdated or invalidated. Source: WRT-2516 v2, Chapter 8.</dc:description>
        <dc:hasVersion>0.1</dc:hasVersion>
    </owl:Ontology>
    


