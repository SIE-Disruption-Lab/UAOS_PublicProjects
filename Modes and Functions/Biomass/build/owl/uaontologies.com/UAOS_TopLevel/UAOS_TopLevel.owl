    <!-- http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Continuant -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Continuant">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#IdentifiedEntity"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <rdfs:label>Continuant</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Disposition -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Disposition">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#RealizableEntity"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <rdfs:label>Disposition</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Energy -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Energy">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#ImmaterialEntity"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <rdfs:label>Energy</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Function -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Function">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Disposition"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasContinuantPart"/>
                <owl:allValuesFrom rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Function"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#isContinuantPartOf"/>
                <owl:allValuesFrom rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Function"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <rdfs:label>Function</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#GDCCarrier -->


