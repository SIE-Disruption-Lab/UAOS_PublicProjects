    <!-- http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasBeginInstant -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasBeginInstant">
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#TemporalRegion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <dc:description>[=hasBeginInstant=] ...</dc:description>
        <rdfs:label>has begin instant</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasEndInstant -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasEndInstant">
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#TemporalRegion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <dc:description>[=hasEndInstant=] ...</dc:description>
        <rdfs:label>has end instant</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasID -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasID">
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#IdentifiedEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:description>[=hasID=] is a FOUNDATIONAL scalar property - all entities can have an ID</dc:description>
        <rdfs:label>has ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasName -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasName">
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#IdentifiedEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:description>[=hasName=] is a FOUNDATIONAL scalar property - all entities can have a name</dc:description>
        <rdfs:label>has name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasNaturalLanguageDescription -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasNaturalLanguageDescription">
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#IdentifiedEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:description>[=hasNaturalLanguageDescription=] is a FOUNDATIONAL scalar property - all entities can have a natural language description</dc:description>
        <rdfs:label>has natural language description</rdfs:label>
    </owl:DatatypeProperty>
    


