    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#occupies -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#occupies">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#MaterialEntity"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Site"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Occupies"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
