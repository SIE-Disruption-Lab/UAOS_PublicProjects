<?xml version="1.0"?>
<rdf:RDF xmlns="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#"
     xml:base="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:oml="http://opencaesar.io/oml#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:tlo="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#">
    <owl:Ontology rdf:about="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel">
        <owl:imports rdf:resource="http://purl.org/dc/elements/1.1"/>
        <oml:namespace rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#"/>
        <oml:prefix>tlo</oml:prefix>
        <oml:type rdf:resource="http://opencaesar.io/oml#Vocabulary"/>
        <dc:contributor>Joe Gregory</dc:contributor>
        <dc:creator>SIE Disruption Lab</dc:creator>
        <dc:description>A vocabulary to capture the top level terminology required by the SIE Disruption Lab. Note that this is essentially a simplified version of BFO.</dc:description>
        <dc:hasVersion>0.1</dc:hasVersion>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://opencaesar.io/oml#relationBase -->


    <owl:AnnotationProperty rdf:about="http://opencaesar.io/oml#relationBase"/>
    


    <!-- http://opencaesar.io/oml#relationEntity -->


    <owl:AnnotationProperty rdf:about="http://opencaesar.io/oml#relationEntity"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://opencaesar.io/oml#hasSource -->


    <owl:ObjectProperty rdf:about="http://opencaesar.io/oml#hasSource"/>
    


    <!-- http://opencaesar.io/oml#hasTarget -->


    <owl:ObjectProperty rdf:about="http://opencaesar.io/oml#hasTarget"/>
    


    <!-- http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#gdo -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#gdo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#GenericallyDependentContinuant"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#GDCCarrier"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#GenericallyDependentOn"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>generically dependent on</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasContinuantPart -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasContinuantPart">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Continuant"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Continuant"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#HasContinuantPart"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>has continuant part</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasMemberPart -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasMemberPart">
        <rdfs:subPropertyOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasContinuantPart"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#MaterialEntity"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#MaterialEntity"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#HasMemberPart"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>has member part</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasOccurrentPart -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasOccurrentPart">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Occurrent"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Occurrent"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#HasOccurrentPart"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>has occurrent part</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasSpatialPart -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasSpatialPart">
        <rdfs:subPropertyOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasContinuantPart"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#ImmaterialEntity"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#ImmaterialEntity"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#HasSpatialPart"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>has spatial part</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hgd -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hgd">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#gdo"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#GDCCarrier"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#GenericallyDependentContinuant"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#GenericallyDependentOn"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>is carrier of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hsd -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hsd">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#sdo"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#SDCCarrier"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#SpecificallyDependentContinuant"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#SpecificallyDependentOn"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>is specifically depended on by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#isContinuantPartOf -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#isContinuantPartOf">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasContinuantPart"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Continuant"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Continuant"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#HasContinuantPart"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>is continuant part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#isMemberPartOf -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#isMemberPartOf">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasMemberPart"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#MaterialEntity"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#MaterialEntity"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#HasMemberPart"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>is member part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#isOccupiedBy -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#isOccupiedBy">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#occupies"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Site"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#MaterialEntity"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Occupies"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>is occupied by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#isOccurrentPartOf -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#isOccurrentPartOf">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasOccurrentPart"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Occurrent"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Occurrent"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#HasOccurrentPart"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>is occurrent part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#isSpatialPartOf -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#isSpatialPartOf">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasSpatialPart"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#ImmaterialEntity"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#ImmaterialEntity"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#HasSpatialPart"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
