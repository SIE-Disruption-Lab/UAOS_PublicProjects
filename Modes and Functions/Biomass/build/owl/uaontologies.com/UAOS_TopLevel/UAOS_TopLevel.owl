    <!-- http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#sdo -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#sdo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#SpecificallyDependentContinuant"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#SDCCarrier"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#SpecificallyDependentOn"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
