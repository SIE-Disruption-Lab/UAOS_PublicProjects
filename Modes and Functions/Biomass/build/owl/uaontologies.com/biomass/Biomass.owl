    <!-- http://uaontologies.com/biomass/Biomass#T_aocs_ash_to_nmg -->


    <owl:NamedIndividual rdf:about="http://uaontologies.com/biomass/Biomass#T_aocs_ash_to_nmg">
        <rdf:type rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_States#Transition"/>
        <UAOS_TopLevel:sdo rdf:resource="http://uaontologies.com/biomass/Biomass#aocs"/>
        <UAOS_TopLevel:hasName>AOCS ASH-to-NM-GAP Transition</UAOS_TopLevel:hasName>
        <oml:type rdf:resource="http://opencaesar.io/oml#ConceptInstance"/>
    </owl:NamedIndividual>
    


    <!-- http://uaontologies.com/biomass/Biomass#T_aocs_nmg_to_ash -->


    <owl:NamedIndividual rdf:about="http://uaontologies.com/biomass/Biomass#T_aocs_nmg_to_ash">
        <rdf:type rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_States#Transition"/>
        <UAOS_TopLevel:sdo rdf:resource="http://uaontologies.com/biomass/Biomass#aocs"/>
        <UAOS_TopLevel:hasName>AOCS NM-GAP-to-ASH Transition</UAOS_TopLevel:hasName>
        <UAOS_TopLevel:hasNaturalLanguageDescription>Intended recovery transition from Normal Mode (GAP) back to ASH. In the MOCD, this path existed only as an alarm-triggered (FDIR) transition, not as a TC-commandable route. The SEAM deployment simulation failed when this transition was requested (thesis §8.6, p.147): no TC-commandable NM-to-ASH path was defined. The absence of exitedBy models this: the transition is not available in aocs_nmg, and the TransitionAvailability rule does not fire. Query Q03 detects the missing source mode.</UAOS_TopLevel:hasNaturalLanguageDescription>
        <oml:type rdf:resource="http://opencaesar.io/oml#ConceptInstance"/>
    </owl:NamedIndividual>
    


    <!-- http://uaontologies.com/biomass/Biomass#T_aocs_nmg_to_nmc -->


    <owl:NamedIndividual rdf:about="http://uaontologies.com/biomass/Biomass#T_aocs_nmg_to_nmc">
        <rdf:type rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_States#Transition"/>
        <UAOS_TopLevel:sdo rdf:resource="http://uaontologies.com/biomass/Biomass#aocs"/>
        <UAOS_TopLevel:hasName>AOCS NM-GAP-to-NM-CAP Transition</UAOS_TopLevel:hasName>
        <UAOS_TopLevel:hasNaturalLanguageDescription>Transitions AOCS from Geocentric Pointing (GAP) to Custom Accurate Pointing (CAP) sub-mode. Commanded when spacecraft enters Nominal Mode, enabling precision attitude for SAR acquisitions.</UAOS_TopLevel:hasNaturalLanguageDescription>
        <oml:type rdf:resource="http://opencaesar.io/oml#ConceptInstance"/>
    </owl:NamedIndividual>
    


