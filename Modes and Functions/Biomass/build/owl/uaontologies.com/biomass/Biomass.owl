    <!-- http://uaontologies.com/biomass/Biomass#T_sar_meas_to_ready -->


    <owl:NamedIndividual rdf:about="http://uaontologies.com/biomass/Biomass#T_sar_meas_to_ready">
        <rdf:type rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_States#Transition"/>
        <UAOS_TopLevel:sdo rdf:resource="http://uaontologies.com/biomass/Biomass#sar"/>
        <UAOS_TopLevel:hasName>SAR Measurement-to-Ready Transition</UAOS_TopLevel:hasName>
        <oml:type rdf:resource="http://opencaesar.io/oml#ConceptInstance"/>
    </owl:NamedIndividual>
    


    <!-- http://uaontologies.com/biomass/Biomass#T_sar_off_to_ready -->


    <owl:NamedIndividual rdf:about="http://uaontologies.com/biomass/Biomass#T_sar_off_to_ready">
        <rdf:type rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_States#Transition"/>
        <UAOS_TopLevel:sdo rdf:resource="http://uaontologies.com/biomass/Biomass#sar"/>
        <UAOS_TopLevel:hasName>SAR Off-to-Ready Transition</UAOS_TopLevel:hasName>
        <UAOS_TopLevel:hasNaturalLanguageDescription>Powers on and initialises the SAR instrument to Ready mode. Executed during POM entry sequence. Includes boot, application software load, and thermal stabilisation.</UAOS_TopLevel:hasNaturalLanguageDescription>
        <oml:type rdf:resource="http://opencaesar.io/oml#ConceptInstance"/>
    </owl:NamedIndividual>
    


