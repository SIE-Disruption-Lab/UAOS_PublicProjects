        <owl:imports rdf:resource="http://purl.org/dc/elements/1.1"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Modes"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_States"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_SystemArchitecture"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel"/>
        <oml:namespace rdf:resource="http://uaontologies.com/biomass/Biomass#"/>
        <oml:prefix>bio</oml:prefix>
        <oml:type rdf:resource="http://opencaesar.io/oml#Description"/>
        <dc:creator>Joe Gregory</dc:creator>
        <dc:description>A description instantiating the UAOS_Modes vocabulary for a partial model of the ESA Biomass spacecraft, drawn from the published case studies in Chapters 7 and 8 of Gregory PhD Thesis (2022).</dc:description>
        <dc:hasVersion>0.2</dc:hasVersion>
    </owl:Ontology>
    


