        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>estimate of quantity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Types#estimatedBy -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Types#estimatedBy">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Types#estimateOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Types#QuantityType"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Types#Estimate"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Types#EstimateOf"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>estimated by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Types#isDimensionOfType -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Types#isDimensionOfType">
