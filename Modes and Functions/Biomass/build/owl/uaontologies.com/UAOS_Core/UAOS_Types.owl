    <!-- http://uaontologies.com/UAOS_Core/UAOS_Types#Estimate -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Types#Estimate">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#DescriptiveICE"/>
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Value"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#hasUnit"/>
                <owl:someValuesFrom rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Unit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Types#estimateOf"/>
                <owl:someValuesFrom rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Types#QuantityType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=Estimate=] is a Descriptive ICE and Value describes a quantity by predicting its value.</dc:description>
        <rdfs:label>Estimate</rdfs:label>
    </owl:Class>
    


