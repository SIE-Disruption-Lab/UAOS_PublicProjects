<?xml version="1.0"?>
<rdf:RDF xmlns="http://uaontologies.com/UAOS_Core/UAOS_Measurement#"
     xml:base="http://uaontologies.com/UAOS_Core/UAOS_Measurement"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:oml="http://opencaesar.io/oml#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:UAOS_Measurement="http://uaontologies.com/UAOS_Core/UAOS_Measurement#">
    <owl:Ontology rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Measurement">
        <owl:imports rdf:resource="http://purl.org/dc/elements/1.1"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel"/>
        <oml:namespace rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#"/>
        <oml:prefix>UAOS_Measurement</oml:prefix>
        <oml:type rdf:resource="http://opencaesar.io/oml#Vocabulary"/>
        <dc:contributor>Joe Gregory</dc:contributor>
        <dc:creator>SIE Disruption Lab</dc:creator>
        <dc:description>A vocabulary to capture the measurement patterns required by the SIE Disruption Lab. Note that this is essentially a simplified Measurement CCO.</dc:description>
        <dc:hasVersion>0.1</dc:hasVersion>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Measurement#calculatedUsing -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Measurement#calculatedUsing">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Quantity"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Quantity"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#CalculatedUsing"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>calculated using</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Measurement#hasApplicableDimension -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Measurement#hasApplicableDimension">
        <rdfs:subPropertyOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#describes"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Unit"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Dimension"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#HasApplicableDimension"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>has applicable dimension</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Measurement#hasDimension -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Measurement#hasDimension">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#isDimensionOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Quantity"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Dimension"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#IsDimensionOf"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>has dimension</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Measurement#hasUnit -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Measurement#hasUnit">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Value"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Unit"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#HasUnit"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>has unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Measurement#isApplicableDimensionOf -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Measurement#isApplicableDimensionOf">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#hasApplicableDimension"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Dimension"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Unit"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#HasApplicableDimension"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>is applicable dimension of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Measurement#isDimensionOf -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Measurement#isDimensionOf">
        <rdfs:subPropertyOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#describes"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Dimension"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Quantity"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#IsDimensionOf"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>is dimension of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Measurement#isUnitOf -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Measurement#isUnitOf">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#hasUnit"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Unit"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Value"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#HasUnit"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>is unit of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Measurement#measuredBy -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Measurement#measuredBy">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#measurementOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Quantity"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Measurement"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#MeasurementOf"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>measured by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Measurement#measurementOf -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Measurement#measurementOf">
        <rdfs:subPropertyOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#describes"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Measurement"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Quantity"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#MeasurementOf"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>measurement of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Measurement#usedInCalculation -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Measurement#usedInCalculation">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#calculatedUsing"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Quantity"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Quantity"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#CalculatedUsing"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>used in calculation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Measurement#hasBooleanValue -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Measurement#hasBooleanValue">
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Value"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <dc:description>[=hasBooleanValue=] ...</dc:description>
        <rdfs:label>has Boolean value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Measurement#hasConfidence -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Measurement#hasConfidence">
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#ConfidenceInterval"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dc:description>[=hasConfidence=] ...</dc:description>
        <rdfs:label>has confidence</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Measurement#hasLowerValue -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Measurement#hasLowerValue">
        <rdfs:subPropertyOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#hasValue"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Range"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <dc:description>[=hasLowerValue=] ...</dc:description>
        <rdfs:label>has lower value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Measurement#hasUpperValue -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Measurement#hasUpperValue">
        <rdfs:subPropertyOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#hasValue"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Range"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <dc:description>[=hasUpperValue=] ...</dc:description>
        <rdfs:label>has upper value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Measurement#hasValue -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Measurement#hasValue">
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Value"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <dc:description>[=hasValue=] ...</dc:description>
        <rdfs:label>has value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Measurement#CalculatedUsing -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Measurement#CalculatedUsing">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=CalculatedUsing=] relates a quantity to another quantity.</dc:description>
        <rdfs:label>CalculatedUsing</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Measurement#ConfidenceInterval -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Measurement#ConfidenceInterval">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Range"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=ConfidenceInterval=]...</dc:description>
        <rdfs:label>Confidence Interval</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Measurement#Dimension -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Dimension">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#DescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=Dimension=]...</dc:description>
        <rdfs:label>Dimension</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Measurement#HasApplicableDimension -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Measurement#HasApplicableDimension">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#Describes"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasApplicableDimension=] is a...</dc:description>
        <rdfs:label>Has Applicable Dimension</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Measurement#HasUnit -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Measurement#HasUnit">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasUnit=] is a...</dc:description>
        <rdfs:label>Has Unit</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Measurement#IsDimensionOf -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Measurement#IsDimensionOf">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#Describes"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=IsDimensionOf=] is a...</dc:description>
        <rdfs:label>Is Dimension Of</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Measurement#Measurement -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Measurement">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#DescriptiveICE"/>
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Value"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#hasUnit"/>
                <owl:someValuesFrom rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Unit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#measurementOf"/>
                <owl:someValuesFrom rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Quantity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=Measurement=]...</dc:description>
        <rdfs:label>Measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Measurement#MeasurementOf -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Measurement#MeasurementOf">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#Describes"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=MeasurementOf=] is a...</dc:description>
        <rdfs:label>Measurement Of</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Measurement#Quantity -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Quantity">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Quality"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#hasDimension"/>
                <owl:someValuesFrom rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Dimension"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=Quantity=]...</dc:description>
        <rdfs:label>Quantity</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Measurement#Range -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Range">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Measurement"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=Range=]...</dc:description>
        <rdfs:label>Range</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Measurement#SimpleMeasurement -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Measurement#SimpleMeasurement">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Measurement"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=SimpleMeasurement=]...</dc:description>
        <rdfs:label>Simple Measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Measurement#Unit -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Unit">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#DescriptiveICE"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#hasApplicableDimension"/>
                <owl:someValuesFrom rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Dimension"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=Unit=]...</dc:description>
        <rdfs:label>Unit</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Measurement#Value -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Value">
        <oml:type rdf:resource="http://opencaesar.io/oml#Aspect"/>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Rules
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <rdf:Description rdf:about="urn:swrl:var#r">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="urn:swrl:var#s">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="urn:swrl:var#t">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description>
        <rdfs:label>hasApplicableDimension derivation</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#HasApplicableDimension"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
