    <rdf:Description>
        <oml:name>http://uaontologies.com/UAOS_Core/UAOS_Provenance#Derivation_transitivity</oml:name>
        <oml:type>http://opencaesar.io/oml#Rule</oml:type>
        <rdfs:comment>Derivation is transitive: if C was derived from B and B from A, then C was derived from A.</rdfs:comment>
