<?xml version="1.0"?>
<rdf:RDF xmlns="http://uaontologies.com/UAOS_Core/UAOS_Provenance#"
     xml:base="http://uaontologies.com/UAOS_Core/UAOS_Provenance"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:oml="http://opencaesar.io/oml#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:UAOS_Prov="http://uaontologies.com/UAOS_Core/UAOS_Provenance#">
    <owl:Ontology rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Provenance">
        <owl:imports rdf:resource="http://purl.org/dc/elements/1.1"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Agent"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel"/>
        <oml:namespace rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Provenance#"/>
        <oml:prefix>UAOS_Prov</oml:prefix>
        <oml:type rdf:resource="http://opencaesar.io/oml#Vocabulary"/>
        <dc:contributor>Joe Gregory</dc:contributor>
        <dc:creator>SIE Disruption Lab</dc:creator>
        <dc:description>Extended provenance vocabulary for the UAOS. Conforms to the PROV-O to BFO mapping (Prudhomme et al. 2025). Adds derivation chains, process-level attribution, and version tracking needed for digital thread traceability.</dc:description>
        <dc:hasVersion>0.2</dc:hasVersion>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Provenance#approvedBy -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Provenance#approvedBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#InformationArtifact"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Agent#Agent"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Provenance#ApprovedBy"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>approved by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Provenance#approves -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Provenance#approves">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Provenance#approvedBy"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Agent#Agent"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#InformationArtifact"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Provenance#ApprovedBy"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>approves</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Provenance#generatedBy -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Provenance#generatedBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#InformationArtifact"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Agent#Agent"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Provenance#GeneratedBy"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>generated by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Provenance#generates -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Provenance#generates">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Provenance#generatedBy"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Agent#Agent"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#InformationArtifact"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Provenance#GeneratedBy"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>generates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Provenance#generatesArtifact -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Provenance#generatesArtifact">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Provenance#wasGeneratedByProcess"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Process"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#InformationArtifact"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Provenance#WasGeneratedByProcess"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>generates artifact</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Provenance#isSourceOf -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Provenance#isSourceOf">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Provenance#wasDerivedFrom"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#InformationArtifact"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#InformationArtifact"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Provenance#WasDerivedFrom"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>is source of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Provenance#used -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Provenance#used">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Process"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#InformationArtifact"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Provenance#Used"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>used</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Provenance#wasAssociatedWith -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Provenance#wasAssociatedWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Process"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Agent#Agent"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Provenance#WasAssociatedWith"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>was associated with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Provenance#wasAssociatedWithProcess -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Provenance#wasAssociatedWithProcess">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Provenance#wasAssociatedWith"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Agent#Agent"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Process"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Provenance#WasAssociatedWith"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>was associated with process</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Provenance#wasDerivedFrom -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Provenance#wasDerivedFrom">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#InformationArtifact"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#InformationArtifact"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Provenance#WasDerivedFrom"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>was derived from</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Provenance#wasGeneratedByProcess -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Provenance#wasGeneratedByProcess">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#InformationArtifact"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Process"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Provenance#WasGeneratedByProcess"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>was generated by process</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Provenance#wasUsedBy -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Provenance#wasUsedBy">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Provenance#used"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#InformationArtifact"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Process"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Provenance#Used"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>was used by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Provenance#approvedAt -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Provenance#approvedAt">
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#InformationArtifact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <dc:description>[=approvedAt=] records the timestamp at which an artifact was approved.</dc:description>
        <rdfs:label>approved at</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Provenance#generatedAt -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Provenance#generatedAt">
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#InformationArtifact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <dc:description>[=generatedAt=] records the timestamp at which an artifact was produced.</dc:description>
        <rdfs:label>generated at</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Provenance#hadVersion -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Provenance#hadVersion">
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#InformationArtifact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:description>[=hadVersion=] records a version identifier for an InformationArtifact.</dc:description>
        <rdfs:label>had version</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Provenance#wasInvalidatedAtTime -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Provenance#wasInvalidatedAtTime">
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#InformationArtifact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <dc:description>[=wasInvalidatedAtTime=] records when an artifact was superseded or invalidated.</dc:description>
        <rdfs:label>was invalidated at time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Provenance#ApprovedBy -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Provenance#ApprovedBy">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=ApprovedBy=] relates an InformationArtifact to the Agent who authorised it.</dc:description>
        <rdfs:label>Approved By</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Provenance#GeneratedBy -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Provenance#GeneratedBy">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=GeneratedBy=] relates an InformationArtifact to the Agent who produced it. Maps to prov:wasAttributedTo in the PROV-O/BFO alignment.</dc:description>
        <rdfs:label>Generated By</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Provenance#Used -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Provenance#Used">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=Used=] relates a Process to an InformationArtifact it consumed as input. Maps to prov:used, aligned to BFO &apos;has participant (at some time)&apos;.</dc:description>
        <rdfs:label>Used</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Provenance#WasAssociatedWith -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Provenance#WasAssociatedWith">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=WasAssociatedWith=] relates a Process to an Agent that was responsible for it. Maps to prov:wasAssociatedWith, aligned to BFO &apos;has participant (at some time)&apos;.</dc:description>
        <rdfs:label>Was Associated With</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Provenance#WasDerivedFrom -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Provenance#WasDerivedFrom">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=WasDerivedFrom=] relates a derived InformationArtifact to the source artifact from which it was produced. Maps to prov:wasDerivedFrom. Critical for digital thread lineage.</dc:description>
        <rdfs:label>Was Derived From</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Provenance#WasGeneratedByProcess -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Provenance#WasGeneratedByProcess">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=WasGeneratedByProcess=] relates an InformationArtifact to the Process that produced it. Maps to prov:wasGeneratedBy (Activity sense), aligned to BFO &apos;participates in (at some time)&apos;.</dc:description>
        <rdfs:label>Was Generated By Process</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Rules
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <rdf:Description rdf:about="urn:swrl:var#r">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="urn:swrl:var#s">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="urn:swrl:var#t">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="urn:swrl:var#a">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="urn:swrl:var#b">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="urn:swrl:var#c">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="urn:swrl:var#d">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description>
        <rdfs:label>approvedBy derivation</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Provenance#ApprovedBy"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://opencaesar.io/oml#hasSource"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#s"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://opencaesar.io/oml#hasTarget"/>
                                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                        <swrl:argument2 rdf:resource="urn:swrl:var#t"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Provenance#approvedBy"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                        <swrl:argument2 rdf:resource="urn:swrl:var#t"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <rdfs:label>generatedBy derivation</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Provenance#GeneratedBy"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
