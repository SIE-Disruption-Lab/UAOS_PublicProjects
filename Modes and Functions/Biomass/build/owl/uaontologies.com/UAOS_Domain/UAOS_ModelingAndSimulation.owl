    <!-- http://uaontologies.com/UAOS_Domain/UAOS_ModelingAndSimulation#Analysis -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_ModelingAndSimulation#Analysis">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Agent#ManagedProcess"/>
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Verification#VerificationActivity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Agent#hasOutput"/>
                <owl:allValuesFrom rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#DescriptiveICE"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=Analysis=] is a...</dc:description>
        <rdfs:label>Analysis</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_ModelingAndSimulation#Model -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_ModelingAndSimulation#Model">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#InformationArtifact"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hgd"/>
                <owl:someValuesFrom rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#RepresentationalICE"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=Model=] is a...</dc:description>
        <rdfs:label>Model</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_ModelingAndSimulation#Simulation -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_ModelingAndSimulation#Simulation">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_ModelingAndSimulation#Analysis"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Event#hasParticipant"/>
                <owl:someValuesFrom rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_ModelingAndSimulation#Model"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=Simulation=] is a...</dc:description>
        <rdfs:label>Simulation</rdfs:label>
    </owl:Class>
</rdf:RDF>



