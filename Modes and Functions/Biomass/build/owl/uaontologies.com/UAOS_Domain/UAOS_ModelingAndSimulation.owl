<?xml version="1.0"?>
<rdf:RDF xmlns="http://uaontologies.com/UAOS_Domain/UAOS_ModelingAndSimulation#"
     xml:base="http://uaontologies.com/UAOS_Domain/UAOS_ModelingAndSimulation"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:oml="http://opencaesar.io/oml#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:UAOS_ModelingAndSimulation="http://uaontologies.com/UAOS_Domain/UAOS_ModelingAndSimulation#">
    <owl:Ontology rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_ModelingAndSimulation">
        <owl:imports rdf:resource="http://purl.org/dc/elements/1.1"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Agent"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Event"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Verification"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel"/>
        <oml:namespace rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_ModelingAndSimulation#"/>
        <oml:prefix>UAOS_ModelingAndSimulation</oml:prefix>
        <oml:type rdf:resource="http://opencaesar.io/oml#Vocabulary"/>
        <dc:contributor>Joe Gregory</dc:contributor>
        <dc:creator>SIE Disruption Lab</dc:creator>
        <dc:description>A vocabulary to capture modeling and simulation patterns</dc:description>
        <dc:hasVersion>0.1</dc:hasVersion>
    </owl:Ontology>
    


