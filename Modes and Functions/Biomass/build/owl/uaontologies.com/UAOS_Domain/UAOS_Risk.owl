<?xml version="1.0"?>
<rdf:RDF xmlns="http://uaontologies.com/UAOS_Domain/UAOS_Risk#"
     xml:base="http://uaontologies.com/UAOS_Domain/UAOS_Risk"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:oml="http://opencaesar.io/oml#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:UAOS_Risk="http://uaontologies.com/UAOS_Domain/UAOS_Risk#">
    <owl:Ontology rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Risk">
        <owl:imports rdf:resource="http://purl.org/dc/elements/1.1"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Test"/>
        <oml:namespace rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Risk#"/>
        <oml:prefix>UAOS_Risk</oml:prefix>
        <oml:type rdf:resource="http://opencaesar.io/oml#Vocabulary"/>
        <dc:contributor>Joe Gregory</dc:contributor>
        <dc:creator>SIE Disruption Lab</dc:creator>
        <dc:description>A vocabulary capturing risk management concepts for mission engineering and system T&amp;E. Defines Risk as a DescriptiveICE (moved from UAOS_MissionEngineering), with SystemRisk and OperationalRisk subtypes, severity scalar properties aligned to the DoD 5x5 risk matrix scale, and relations linking risks to the tests that inform them and the probabilistic quantities whose values supply their likelihood estimates.</dc:description>
        <dc:hasVersion>0.1</dc:hasVersion>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Risk#hasLikelihoodQuantity -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Risk#hasLikelihoodQuantity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Risk#Risk"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Quantity"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Risk#HasLikelihoodQuantity"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>has likelihood quantity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Risk#informsRisk -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Risk#informsRisk">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Test#Test"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Risk#Risk"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Risk#InformsRisk"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>informs risk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Risk#likelihoodQuantityOf -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Risk#likelihoodQuantityOf">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Risk#hasLikelihoodQuantity"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Quantity"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Risk#Risk"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Risk#HasLikelihoodQuantity"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>likelihood quantity of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Risk#riskInformedBy -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Risk#riskInformedBy">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Risk#informsRisk"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Risk#Risk"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Test#Test"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Risk#InformsRisk"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>risk informed by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Risk#hasSeverityLabel -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Risk#hasSeverityLabel">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Risk#Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:description>[=hasSeverityLabel=] captures the human-readable DoD consequence severity label corresponding to hasSeverityScore: Negligible (1), Marginal (2), Moderate (3), Critical (4), Catastrophic (5).</dc:description>
        <rdfs:label>severity label</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Risk#hasSeverityScore -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Risk#hasSeverityScore">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Risk#Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <dc:description>[=hasSeverityScore=] captures the consequence severity of a Risk on the DoD 5x5 scale: 1=Negligible, 2=Marginal, 3=Moderate, 4=Critical, 5=Catastrophic. Combined with the likelihood derived from the associated quantity, severity score locates the risk in the 5x5 risk matrix.</dc:description>
        <rdfs:label>severity score</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Risk#HasLikelihoodQuantity -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Risk#HasLikelihoodQuantity">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasLikelihoodQuantity=] relates a Risk to a meas:Quantity whose current value supplies the estimated likelihood of the risk. For risks modelled via a Bayesian network, this quantity is typically a latent BN node whose hasBayesianTrueStateValue gives the probability of adequate performance; the risk likelihood is the complement (1 - hasBayesianTrueStateValue). For risks whose likelihood is directly measured (e.g. P_Kill for an OperationalRisk), the quantity value is used directly.</dc:description>
        <rdfs:label>Has Likelihood Quantity</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Risk#InformsRisk -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Risk#InformsRisk">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=InformsRisk=] relates a Test to a Risk that it is designed to reduce or provide information about. A test result (pass or fail) updates the estimated likelihood of the risk materialising. The relation is asymmetric: the test informs the risk, not vice versa.</dc:description>
        <rdfs:label>Informs Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Risk#OperationalRisk -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Risk#OperationalRisk">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Risk#Risk"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>An [=OperationalRisk=] is a Risk that describes a potential adverse event affecting mission execution or operational effectiveness — typically a failure to achieve a desired operational effect as revealed by operational test. The mission it pertains to is captured via info:describes (range: me:Mission). OperationalRisks are the risks that operational testing (OT) is designed to reduce.</dc:description>
        <rdfs:label>OperationalRisk</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Risk#Risk -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Risk#Risk">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#DescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=Risk=] is a DescriptiveICE that describes a potential adverse event together with its estimated likelihood and impact on enterprise goals or mission execution. It is an information entity — a description of a future contingency — not the adverse event itself. NOTE: moved here from UAOS_MissionEngineering to centralise risk management vocabulary.</dc:description>
        <rdfs:label>Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Risk#SystemRisk -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Risk#SystemRisk">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Risk#Risk"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=SystemRisk=] is a Risk that describes a potential adverse event affecting a specific system or subsystem — typically a failure to meet an engineering design specification as revealed by developmental test. The system or subsystem it pertains to is captured via info:describes (range: sa:System or tlo:Object). SystemRisks are the risks that developmental testing (DT) is designed to reduce.</dc:description>
        <rdfs:label>SystemRisk</rdfs:label>
    </owl:Class>
    


