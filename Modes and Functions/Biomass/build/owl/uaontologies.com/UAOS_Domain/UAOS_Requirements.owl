        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel"/>
        <oml:namespace rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Requirements#"/>
        <oml:prefix>UAOS_Requirements</oml:prefix>
        <oml:type rdf:resource="http://opencaesar.io/oml#Vocabulary"/>
        <dc:contributor>Joe Gregory</dc:contributor>
        <dc:creator>SIE Disruption Lab</dc:creator>
        <dc:description>A vocabulary to capture system requirements patterns</dc:description>
        <dc:hasVersion>0.1</dc:hasVersion>
    </owl:Ontology>
    


