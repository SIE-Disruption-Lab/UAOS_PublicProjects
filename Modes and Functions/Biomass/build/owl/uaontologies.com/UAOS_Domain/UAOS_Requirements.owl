        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#represents"/>
                <owl:someValuesFrom rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Requirements#Constraint"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#hasUnit"/>
                <owl:someValuesFrom rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Unit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=ConstraintExpression=]...</dc:description>
        <rdfs:label>ConstraintExpression</rdfs:label>
    </owl:Class>
    


