    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Requirements#ConstraintExpression -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Requirements#ConstraintExpression">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#RepresentationalICE"/>
