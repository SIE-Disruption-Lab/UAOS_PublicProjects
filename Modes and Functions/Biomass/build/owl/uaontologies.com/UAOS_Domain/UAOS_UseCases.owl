    <!-- http://uaontologies.com/UAOS_Domain/UAOS_UseCases#UseCase -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_UseCases#UseCase">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#PrescriptiveICE"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasContinuantPart"/>
                <owl:allValuesFrom rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_UseCases#UseCase"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#isContinuantPartOf"/>
                <owl:allValuesFrom rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_UseCases#UseCase"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=Use Case=] is a...</dc:description>
        <rdfs:label>Use Case</rdfs:label>
    </owl:Class>
    


