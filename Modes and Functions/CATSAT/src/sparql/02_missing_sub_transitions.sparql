##############################################################################
# Query 02 (Revised): Semantically Misaligned Sub-Transitions
#
# Identifies parent Transitions that lack a HasSubTransition correctly
# aligned with the declared mode correspondence at both ends. Mode
# correspondence is declared via hasContinuantPart between Mode instances:
# if a System is in Mode M, each child System is in the mode that M
# hasContinuantPart. A parent Transition from M_source to M_target must
# have a HasSubTransition to a child Transition that exits the corresponding
# child source mode AND enters the corresponding child target mode.
#
# This query detects three classes of defect:
#
# (1) Missing sub-transition: no HasSubTransition to any child Transition.
#
# (2) Wrong-direction sub-transition: a HasSubTransition exists, but it
#     enters the WRONG child target mode (e.g., the reverse transition is
#     wired instead of the forward one).
#
# (3) Missing-source sub-transition: a HasSubTransition exists and enters
#     the correct target, but exits the wrong child source mode (or has no
#     declared source mode at all — a Q03-type defect at the child level).
#     This is detected here at the parent-transition level; Q03 provides
#     the corresponding child-level diagnosis.
#
# Expected result for CATSAT v0.4: two rows (VIOLATIONS):
#   (a) T_adcs_nom_to_sci / ADCS Subsystem / Reaction Wheel Assembly
#       expectedChildSource: rwa_nominal / expectedChildTarget: rwa_science
#       — T_adcs_nom_to_sci hasSubTransition T_rwa_sci_to_nom, which enters
#         rwa_nominal (wrong target; correct target is rwa_science).
#
#   (b) T_adcs_sci_to_nom / ADCS Subsystem / Reaction Wheel Assembly
#       expectedChildSource: rwa_science / expectedChildTarget: rwa_nominal
#       — T_adcs_sci_to_nom hasSubTransition T_rwa_sci_to_nom, which enters
#         rwa_nominal (correct target), but T_rwa_sci_to_nom has no
#         exitedBy assertion (Q03 defect); no sub-transition exits rwa_science.
##############################################################################

PREFIX tlo:    <http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#>
PREFIX States: <http://uaontologies.com/UAOS_Domain/UAOS_States#>
PREFIX modes:  <http://uaontologies.com/UAOS_Domain/UAOS_Modes#>

SELECT DISTINCT ?parentTransition  ?parentTransitionName
                ?parentSystem      ?parentSystemName
                ?childSystem       ?childSystemName
                ?expectedChildSourceMode ?expectedChildSourceModeName
                ?expectedChildTargetMode ?expectedChildTargetModeName
WHERE {
    ?parentTransition  a States:Transition ;
                       tlo:hasName ?parentTransitionName ;
                       tlo:sdo ?parentSystem .
    ?parentSystem      tlo:hasName ?parentSystemName ;
                       tlo:hasContinuantPart ?childSystem .
    ?childSystem       tlo:hasName ?childSystemName .

    # Parent source mode → expected child source mode via hasContinuantPart
    ?parentSourceMode  States:exitedBy ?parentTransition .
    ?parentSourceMode  tlo:hasContinuantPart ?expectedChildSourceMode .
    ?expectedChildSourceMode a modes:Mode ;
                              tlo:sdo ?childSystem ;
                              tlo:hasName ?expectedChildSourceModeName .

    # Parent target mode → expected child target mode via hasContinuantPart
    ?parentTargetMode  States:enteredBy ?parentTransition .
    ?parentTargetMode  tlo:hasContinuantPart ?expectedChildTargetMode .
    ?expectedChildTargetMode a modes:Mode ;
                              tlo:sdo ?childSystem ;
                              tlo:hasName ?expectedChildTargetModeName .

    # ALIGNMENT FILTER: retain (parentTransition, childSystem) pairs where
    # NO sub-transition both exits the expected child source mode AND enters
    # the expected child target mode. Detects missing, wrong-direction, and
    # wrong-source sub-transitions.
    FILTER NOT EXISTS {
        ?parentTransition modes:hasSubTransition ?childTransition .
        ?expectedChildSourceMode States:exitedBy ?childTransition .
        ?expectedChildTargetMode States:enteredBy ?childTransition .
    }
}
ORDER BY ?parentSystemName ?parentTransitionName ?childSystemName
