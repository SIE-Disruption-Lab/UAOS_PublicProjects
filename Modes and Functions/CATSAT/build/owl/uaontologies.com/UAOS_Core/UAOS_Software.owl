    <!-- http://uaontologies.com/UAOS_Core/UAOS_Software#HasEntitySource -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Software#HasEntitySource">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasEntitySource=] relates any IdentifiedEntity to the Software from which it originated.</dc:description>
        <rdfs:label>Has Entity Source</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Software#HasSoftwareVendor -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Software#HasSoftwareVendor">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasSoftwareVendor=] relates a Software to the Organisation that develops or distributes it.</dc:description>
        <rdfs:label>Has Software Vendor</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Software#OperatingSystem -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Software#OperatingSystem">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Software#Software"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>An [=OperatingSystem=] is software that provides platform services to other software.</dc:description>
        <rdfs:label>Operating System</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Software#Software -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Software#Software">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#GenericallyDependentContinuant"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#gdo"/>
                <owl:allValuesFrom rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Object"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=Software=] is a generically dependent continuant — an information structure that can be instantiated on multiple material carriers (computers, servers, etc.).</dc:description>
        <rdfs:label>Software</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Software#SoftwareAgent -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Software#SoftwareAgent">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Agent#Agent"/>
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Software#Software"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=SoftwareAgent=] is software that also acts as an agent — it can participate in processes and bear roles.</dc:description>
        <rdfs:label>Software Agent</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Core/UAOS_Software#Supports -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Software#Supports">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=Supports=] relates a Software to a Process it is capable of enabling. Generalised from domain-specific task reference.</dc:description>
        <rdfs:label>Supports</rdfs:label>
    </owl:Class>
    


