    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Core/UAOS_Software#hasSoftwareVersion">
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Software#Software"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
