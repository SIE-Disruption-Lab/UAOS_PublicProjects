    <!-- http://uaontologies.com/UAOS_Libraries/UAOS_INCOSERules#C10_Complete -->


    <owl:NamedIndividual rdf:about="http://uaontologies.com/UAOS_Libraries/UAOS_INCOSERules#C10_Complete">
        <rdf:type rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#SetQualityCharacteristic"/>
        <UAOS_RequirementsQuality:hasCharacteristicId>C10</UAOS_RequirementsQuality:hasCharacteristicId>
        <UAOS_TopLevel:hasNaturalLanguageDescription>The requirement set stands alone such that it sufficiently describes the necessary capabilities, characteristics, constraints, and/or quality factors.</UAOS_TopLevel:hasNaturalLanguageDescription>
        <oml:type rdf:resource="http://opencaesar.io/oml#ConceptInstance"/>
        <rdfs:label>Complete (Set)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://uaontologies.com/UAOS_Libraries/UAOS_INCOSERules#C11_Consistent -->


    <owl:NamedIndividual rdf:about="http://uaontologies.com/UAOS_Libraries/UAOS_INCOSERules#C11_Consistent">
        <rdf:type rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#SetQualityCharacteristic"/>
        <UAOS_RequirementsQuality:hasCharacteristicId>C11</UAOS_RequirementsQuality:hasCharacteristicId>
        <UAOS_TopLevel:hasNaturalLanguageDescription>The set of requirements contains individual requirements that are unique, do not conflict, and are not duplicated.</UAOS_TopLevel:hasNaturalLanguageDescription>
        <oml:type rdf:resource="http://opencaesar.io/oml#ConceptInstance"/>
        <rdfs:label>Consistent</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://uaontologies.com/UAOS_Libraries/UAOS_INCOSERules#C12_Feasible -->


    <owl:NamedIndividual rdf:about="http://uaontologies.com/UAOS_Libraries/UAOS_INCOSERules#C12_Feasible">
        <rdf:type rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#SetQualityCharacteristic"/>
        <UAOS_RequirementsQuality:hasCharacteristicId>C12</UAOS_RequirementsQuality:hasCharacteristicId>
        <UAOS_TopLevel:hasNaturalLanguageDescription>The requirement set can be realized within entity constraints with acceptable risk.</UAOS_TopLevel:hasNaturalLanguageDescription>
        <oml:type rdf:resource="http://opencaesar.io/oml#ConceptInstance"/>
        <rdfs:label>Feasible (Set)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://uaontologies.com/UAOS_Libraries/UAOS_INCOSERules#C13_Comprehensible -->


    <owl:NamedIndividual rdf:about="http://uaontologies.com/UAOS_Libraries/UAOS_INCOSERules#C13_Comprehensible">
        <rdf:type rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#SetQualityCharacteristic"/>
        <UAOS_RequirementsQuality:hasCharacteristicId>C13</UAOS_RequirementsQuality:hasCharacteristicId>
        <UAOS_TopLevel:hasNaturalLanguageDescription>The requirement set is written such that it is clear, structured, and readable.</UAOS_TopLevel:hasNaturalLanguageDescription>
        <oml:type rdf:resource="http://opencaesar.io/oml#ConceptInstance"/>
        <rdfs:label>Comprehensible</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://uaontologies.com/UAOS_Libraries/UAOS_INCOSERules#C14_AbleToBeValidated -->


    <owl:NamedIndividual rdf:about="http://uaontologies.com/UAOS_Libraries/UAOS_INCOSERules#C14_AbleToBeValidated">
        <rdf:type rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#SetQualityCharacteristic"/>
        <UAOS_RequirementsQuality:hasCharacteristicId>C14</UAOS_RequirementsQuality:hasCharacteristicId>
        <UAOS_TopLevel:hasNaturalLanguageDescription>The requirement set can be proven to satisfy its intended use in the operational environment.</UAOS_TopLevel:hasNaturalLanguageDescription>
        <oml:type rdf:resource="http://opencaesar.io/oml#ConceptInstance"/>
        <rdfs:label>Able to be Validated</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://uaontologies.com/UAOS_Libraries/UAOS_INCOSERules#C15_Correct -->


    <owl:NamedIndividual rdf:about="http://uaontologies.com/UAOS_Libraries/UAOS_INCOSERules#C15_Correct">
        <rdf:type rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#SetQualityCharacteristic"/>
        <UAOS_RequirementsQuality:hasCharacteristicId>C15</UAOS_RequirementsQuality:hasCharacteristicId>
        <UAOS_TopLevel:hasNaturalLanguageDescription>The requirement set accurately represents the entity needs from which it was transformed.</UAOS_TopLevel:hasNaturalLanguageDescription>
        <oml:type rdf:resource="http://opencaesar.io/oml#ConceptInstance"/>
        <rdfs:label>Correct (Set)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://uaontologies.com/UAOS_Libraries/UAOS_INCOSERules#C1_Necessary -->


