<?xml version="1.0"?>
<rdf:RDF xmlns="http://uaontologies.com/UAOS_Libraries/UAOS_INCOSERules#"
     xml:base="http://uaontologies.com/UAOS_Libraries/UAOS_INCOSERules"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:oml="http://opencaesar.io/oml#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:UAOS_TopLevel="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#"
     xmlns:UAOS_INCOSERules="http://uaontologies.com/UAOS_Libraries/UAOS_INCOSERules#"
     xmlns:UAOS_RequirementsQuality="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#">
    <owl:Ontology rdf:about="http://uaontologies.com/UAOS_Libraries/UAOS_INCOSERules">
        <owl:imports rdf:resource="http://purl.org/dc/elements/1.1"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel"/>
        <oml:namespace rdf:resource="http://uaontologies.com/UAOS_Libraries/UAOS_INCOSERules#"/>
        <oml:prefix>UAOS_INCOSERules</oml:prefix>
        <oml:type rdf:resource="http://opencaesar.io/oml#Description"/>
        <dc:contributor>Joe Gregory</dc:contributor>
        <dc:creator>SIE Disruption Lab</dc:creator>
        <dc:description>Canonical instance library for the INCOSE Guide to Writing Requirements V4 (1 Jul 2023). Instantiates all 42 writing rules, 15 quality characteristics, 14 rule categories, 4 severity ratings, and 3 applicability levels defined in that guide. Cross-reference matrix (Rule x Characteristic) derived from Appendix E, p.137. Rule applicability and project dictionary requirements derived from Appendix D, pp.131-136. Source: incose-req-rules.ttl (Arizona SIE lab, v0.1.0).</dc:description>
        <dc:hasVersion>0.1</dc:hasVersion>
    </owl:Ontology>
    


