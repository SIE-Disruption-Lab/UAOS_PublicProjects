        <rdf:type rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#IndividualQualityCharacteristic"/>
        <UAOS_RequirementsQuality:hasCharacteristicId>C1</UAOS_RequirementsQuality:hasCharacteristicId>
        <UAOS_TopLevel:hasNaturalLanguageDescription>The requirement defines an essential capability, characteristic, constraint, or quality factor.</UAOS_TopLevel:hasNaturalLanguageDescription>
        <oml:type rdf:resource="http://opencaesar.io/oml#ConceptInstance"/>
        <rdfs:label>Necessary</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://uaontologies.com/UAOS_Libraries/UAOS_INCOSERules#C2_Appropriate -->


    <owl:NamedIndividual rdf:about="http://uaontologies.com/UAOS_Libraries/UAOS_INCOSERules#C2_Appropriate">
        <rdf:type rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#IndividualQualityCharacteristic"/>
        <UAOS_RequirementsQuality:hasCharacteristicId>C2</UAOS_RequirementsQuality:hasCharacteristicId>
        <UAOS_TopLevel:hasNaturalLanguageDescription>The specific intent and amount of detail is appropriate to the level of the entity to which it refers.</UAOS_TopLevel:hasNaturalLanguageDescription>
        <oml:type rdf:resource="http://opencaesar.io/oml#ConceptInstance"/>
        <rdfs:label>Appropriate</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://uaontologies.com/UAOS_Libraries/UAOS_INCOSERules#C3_Unambiguous -->


    <owl:NamedIndividual rdf:about="http://uaontologies.com/UAOS_Libraries/UAOS_INCOSERules#C3_Unambiguous">
        <rdf:type rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#IndividualQualityCharacteristic"/>
        <UAOS_RequirementsQuality:hasCharacteristicId>C3</UAOS_RequirementsQuality:hasCharacteristicId>
        <UAOS_TopLevel:hasNaturalLanguageDescription>The requirement is stated such that it can be interpreted in only one way.</UAOS_TopLevel:hasNaturalLanguageDescription>
        <oml:type rdf:resource="http://opencaesar.io/oml#ConceptInstance"/>
        <rdfs:label>Unambiguous</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://uaontologies.com/UAOS_Libraries/UAOS_INCOSERules#C4_Complete -->


    <owl:NamedIndividual rdf:about="http://uaontologies.com/UAOS_Libraries/UAOS_INCOSERules#C4_Complete">
