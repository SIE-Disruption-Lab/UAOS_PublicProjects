        <UAOS_RequirementsQuality:hasCharacteristicId>C4</UAOS_RequirementsQuality:hasCharacteristicId>
        <UAOS_TopLevel:hasNaturalLanguageDescription>The requirement sufficiently describes the necessary capability, characteristic, constraint, or quality factor to meet the entity need.</UAOS_TopLevel:hasNaturalLanguageDescription>
        <oml:type rdf:resource="http://opencaesar.io/oml#ConceptInstance"/>
        <rdfs:label>Complete</rdfs:label>
    </owl:NamedIndividual>
    


