<?xml version="1.0"?>
<rdf:RDF xmlns="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#"
     xml:base="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:oml="http://opencaesar.io/oml#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:UAOS_DE="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#">
    <owl:Ontology rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment">
        <owl:imports rdf:resource="http://purl.org/dc/elements/1.1"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Agent"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Types"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel"/>
        <oml:namespace rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#"/>
        <oml:prefix>UAOS_DE</oml:prefix>
        <oml:type rdf:resource="http://opencaesar.io/oml#Vocabulary"/>
        <dc:contributor>Joe Gregory</dc:contributor>
        <dc:creator>SIE Disruption Lab</dc:creator>
        <dc:description>A vocabulary for Digital Engineering (DE) environments. Models the tool ecosystems, integration patterns, exchange standards, and DE-specific capabilities needed to compare environments across organisations and reason about digital thread continuity and interoperability. Capabilities are modelled as Disposition subclasses (SDCs) at three levels: DEToolCapability (inheres in a DETool — asserted in descriptions), DEEnvironmentCapability (inheres in a DigitalEnvironment — emerges from connected tool combinations, materialised by SPARQL UPDATE), and DEProgramCapability (inheres in an EngineeringProgramme — emerges from multi-organisation interactions, materialised by SPARQL UPDATE). This three-tier SDC pattern replaces the previous DEToolCategory/DECapability/FederatedCapability hierarchy.</dc:description>
        <dc:hasVersion>0.4</dc:hasVersion>
    </owl:Ontology>
    


