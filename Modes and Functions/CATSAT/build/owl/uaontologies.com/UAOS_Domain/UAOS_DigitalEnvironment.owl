    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#OML_RDF">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DataExchangeStandard"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <rdfs:label>OML RDF</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#OSLC -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#OSLC">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DataExchangeStandard"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <rdfs:label>OSLC</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#OperatedBy -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#OperatedBy">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=OperatedBy=] relates a DigitalEnvironment to the Organisation that operates it.</dc:description>
        <rdfs:label>Operated By</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#PLMCapabilityDE -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#PLMCapabilityDE">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEToolCapability"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>The ability to manage product lifecycle data including product structure, bill of materials, configuration items, change control, and model visualisation.</dc:description>
        <rdfs:label>PLM Capability</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#PLMCapabilityKindDE -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#PLMCapabilityKindDE">
