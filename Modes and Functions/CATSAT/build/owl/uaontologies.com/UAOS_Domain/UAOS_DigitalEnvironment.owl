    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#hasToolVendor -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#hasToolVendor">
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DETool"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>has tool vendor</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#integrationFidelity -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#integrationFidelity">
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#ToolIntegration"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:description>Qualitative fidelity level: &apos;Full&apos;, &apos;Partial&apos;, or &apos;Manual&apos;.</dc:description>
        <rdfs:label>integration fidelity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#isBidirectional -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#isBidirectional">
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#ToolIntegration"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>integration is bidirectional</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#isOpenSource -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#isOpenSource">
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DETool"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>is open source</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#isSemanticIntegration -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#isSemanticIntegration">
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#ToolIntegration"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <dc:description>True if this ToolIntegration carries semantically-grounded data — either via the UAOS-backed hub or via OSLC (which preserves linked-data semantics). False for purely syntactic formats such as ReqIF, SysML XMI, or MS Project format.</dc:description>
        <rdfs:label>is semantic integration</rdfs:label>
    </owl:DatatypeProperty>
    


