        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DigitalEnvironment"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#ToolIntegration"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#HasEnvironmentIntegration"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>has environment integration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#hasInstalledTool -->


