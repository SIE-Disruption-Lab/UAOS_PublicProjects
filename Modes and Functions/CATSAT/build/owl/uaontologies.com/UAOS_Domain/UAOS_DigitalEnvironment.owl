     -->


    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#ArchitectureModelingCapabilityDE -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#ArchitectureModelingCapabilityDE">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEToolCapability"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>The ability to create, manage, and query system architecture models.</dc:description>
        <rdfs:label>Architecture Modeling Capability</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#ArchitectureModelingCapabilityKindDE -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#ArchitectureModelingCapabilityKindDE">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEToolCapabilityKind"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <rdfs:label>Architecture Modeling Capability Kind</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#CrossOrgSemanticContinuity -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#CrossOrgSemanticContinuity">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEProgramCapability"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>Emergent programme capability: two or more member organisations both operate hub-based DE environments with at least one cross-org hub-to-hub link, producing a shared semantic graph spanning organisational boundaries.</dc:description>
        <rdfs:label>Cross-Org Semantic Continuity</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEEnvironmentCapability -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEEnvironmentCapability">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Disposition"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#sdo"/>
                <owl:someValuesFrom rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DigitalEnvironment"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=DEEnvironmentCapability=] is a Disposition that inheres in a DigitalEnvironment. It emerges from the specific combination and connectivity of DETools within that environment. Environment capabilities are NOT asserted directly in descriptions — they are materialised by SPARQL UPDATE queries (update_l2_env_capabilities.sparql) after OWL reasoning and owlLoad.</dc:description>
        <rdfs:label>DE Environment Capability</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEProgramCapability -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEProgramCapability">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Disposition"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#sdo"/>
                <owl:someValuesFrom rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#EngineeringProgramme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=DEProgramCapability=] is a Disposition that inheres in an EngineeringProgramme. It emerges from the combined capabilities and integration pathways of multiple member organisations. Programme capabilities are NOT asserted directly in descriptions — they are materialised by SPARQL UPDATE queries (update_l3_prog_capabilities.sparql) after Tier 2 materialisation.</dc:description>
        <rdfs:label>DE Programme Capability</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DETool -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DETool">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#ApplicationComponent"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=DETool=] is an ApplicationComponent used specifically within a Digital Engineering environment.</dc:description>
        <rdfs:label>DE Tool</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEToolCapability -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEToolCapability">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Disposition"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Types#isOfType"/>
                <owl:someValuesFrom rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEToolCapabilityKind"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#sdo"/>
                <owl:someValuesFrom rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DETool"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=DEToolCapability=] is a Disposition that inheres in a specific DETool instance (via tlo:sdo). It is also classified by a DEToolCapabilityKind instance (via types:isOfType), enabling phase-gap SPARQL queries to navigate from kind to capability token without rdf:type subclass traversal. Tool capabilities are asserted directly in descriptions.</dc:description>
        <rdfs:label>DE Tool Capability</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEToolCapabilityKind -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEToolCapabilityKind">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#DescriptiveICE"/>
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Types#Type"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=DEToolCapabilityKind=] is a types:Type that classifies DEToolCapability instances by functional category. As a DescriptiveICE (GDC) it has no bearer constraint, making kind instances suitable as phase-requirement markers without OWL consistency issues. DEToolCapability instances are linked to their kind via types:isOfType.</dc:description>
        <rdfs:label>DE Tool Capability Kind</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DataExchangeStandard -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DataExchangeStandard">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#PrescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=DataExchangeStandard=] is a PrescriptiveICE that specifies how data is formatted and transmitted between DETools.</dc:description>
        <rdfs:label>Data Exchange Standard</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DataIntegrationCapability -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DataIntegrationCapability">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEToolCapability"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>The ability to automatically aggregate data from multiple tools into a unified data model via REST APIs or similar mechanisms.</dc:description>
        <rdfs:label>Data Integration Capability</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DataIntegrationCapabilityKind -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DataIntegrationCapabilityKind">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEToolCapabilityKind"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <rdfs:label>Data Integration Capability Kind</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DesignAnalysisLoopCapability -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DesignAnalysisLoopCapability">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEEnvironmentCapability"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>Emergent environment capability: the environment has both an architecture modelling tool and a simulation/analysis tool connected (via hub or directly), enabling iterative model-based design analysis.</dc:description>
        <rdfs:label>Design Analysis Loop Capability</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DigitalEnvironment -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DigitalEnvironment">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Object"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=DigitalEnvironment=] is the configured collection of DETools, integrations, and data structures operated by an Organisation to support its digital engineering activities.</dc:description>
        <rdfs:label>Digital Environment</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DigitalThreadCapability -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DigitalThreadCapability">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEToolCapability"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>The ability to maintain a connected, queryable chain of data across the full engineering lifecycle.</dc:description>
        <rdfs:label>Digital Thread Capability</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DigitalThreadCapabilityKind -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DigitalThreadCapabilityKind">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEToolCapabilityKind"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <rdfs:label>Digital Thread Capability Kind</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DigitalThreadReadinessCapability -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DigitalThreadReadinessCapability">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEEnvironmentCapability"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>Emergent environment capability: all five discipline tools (requirements, architecture, PM, simulation, and V&amp;T) are connected to a shared integration hub, producing a fully queryable digital thread across the engineering lifecycle.</dc:description>
        <rdfs:label>Digital Thread Readiness Capability</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#FederatedRequirementsManagement -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#FederatedRequirementsManagement">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEProgramCapability"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>Emergent programme capability: two or more member organisations share requirements via a semantically-grounded integration (OSLC or UAOS-backed hub), enabling live cross-organisational traceability.</dc:description>
        <rdfs:label>Federated Requirements Management</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#HasEnvironmentIntegration -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#HasEnvironmentIntegration">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasEnvironmentIntegration=] relates a DigitalEnvironment to a ToolIntegration that operates within or from it.</dc:description>
        <rdfs:label>Has Environment Integration</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#HasInstalledTool -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#HasInstalledTool">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasInstalledTool=] relates a DigitalEnvironment to a DETool deployed within it.</dc:description>
        <rdfs:label>Has Installed Tool</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#HasSourceTool -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#HasSourceTool">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasSourceTool=] identifies the source DETool in a ToolIntegration.</dc:description>
        <rdfs:label>Has Source Tool</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#HasTargetTool -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#HasTargetTool">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasTargetTool=] identifies the target DETool in a ToolIntegration.</dc:description>
        <rdfs:label>Has Target Tool</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#JointDesignAnalysis -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#JointDesignAnalysis">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEProgramCapability"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>Emergent programme capability: two or more member organisations each have a DesignAnalysisLoopCapability and share at least one cross-org integration, enabling coordinated model-based analysis across the programme.</dc:description>
        <rdfs:label>Joint Design Analysis</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#MSProjectFormat -->


