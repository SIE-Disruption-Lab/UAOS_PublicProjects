        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DETool"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DigitalEnvironment"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#HasInstalledTool"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
