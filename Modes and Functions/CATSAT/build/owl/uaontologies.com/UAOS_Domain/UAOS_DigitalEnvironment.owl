        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>is exchange standard of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#isInstalledIn -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#isInstalledIn">
