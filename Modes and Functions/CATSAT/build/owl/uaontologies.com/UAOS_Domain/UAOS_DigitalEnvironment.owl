        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DigitalEnvironment"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DETool"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#HasInstalledTool"/>
