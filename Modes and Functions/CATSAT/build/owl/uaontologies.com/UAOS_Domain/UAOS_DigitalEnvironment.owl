    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#ProjectManagementCapabilityDE -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#ProjectManagementCapabilityDE">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEToolCapability"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>The ability to plan, track, and manage engineering project tasks and milestones.</dc:description>
        <rdfs:label>Project Management Capability</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#ProjectManagementCapabilityKindDE -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#ProjectManagementCapabilityKindDE">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEToolCapabilityKind"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <rdfs:label>Project Management Capability Kind</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#REST_JSON -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#REST_JSON">
