    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#ReqIF -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#ReqIF">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DataExchangeStandard"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <rdfs:label>ReqIF</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#RequirementTraceabilityCapability -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#RequirementTraceabilityCapability">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEToolCapability"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>The ability to capture, link, and trace requirements from stakeholder level through to verification evidence.</dc:description>
        <rdfs:label>Requirement Traceability Capability</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#RequirementTraceabilityCapabilityKind -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#RequirementTraceabilityCapabilityKind">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEToolCapabilityKind"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <rdfs:label>Requirement Traceability Capability Kind</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#SemanticQueryingCapability -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#SemanticQueryingCapability">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEToolCapability"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>The ability to query engineering data using semantic web technologies (SPARQL, OWL reasoning).</dc:description>
        <rdfs:label>Semantic Querying Capability</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#SemanticQueryingCapabilityKind -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#SemanticQueryingCapabilityKind">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEToolCapabilityKind"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <rdfs:label>Semantic Querying Capability Kind</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#SimulationAndAnalysisCapabilityDE -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#SimulationAndAnalysisCapabilityDE">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEToolCapability"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>The ability to run physics-based simulations or quantitative analyses of system designs.</dc:description>
        <rdfs:label>Simulation and Analysis Capability</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#SimulationAndAnalysisCapabilityKindDE -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#SimulationAndAnalysisCapabilityKindDE">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEToolCapabilityKind"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <rdfs:label>Simulation and Analysis Capability Kind</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#SysML_XMI -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#SysML_XMI">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DataExchangeStandard"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <rdfs:label>SysML XMI</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#ToolIntegration -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#ToolIntegration">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#GenericallyDependentContinuant"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#hasSourceTool"/>
                <owl:someValuesFrom rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DETool"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#hasTargetTool"/>
                <owl:someValuesFrom rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DETool"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#usesExchangeStandard"/>
                <owl:someValuesFrom rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DataExchangeStandard"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=ToolIntegration=] represents a configured data exchange pathway between a source DETool and a target DETool, using a specified DataExchangeStandard.</dc:description>
        <rdfs:label>Tool Integration</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#UsesExchangeStandard -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#UsesExchangeStandard">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=UsesExchangeStandard=] relates a ToolIntegration to the DataExchangeStandard it uses.</dc:description>
        <rdfs:label>Uses Exchange Standard</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#VerificationAndTestCapability -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#VerificationAndTestCapability">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEToolCapability"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>The ability to manage test cases, test campaigns, and verification evidence within the DE environment.</dc:description>
        <rdfs:label>Verification and Test Capability</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#VerificationAndTestCapabilityKind -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#VerificationAndTestCapabilityKind">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEToolCapabilityKind"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <rdfs:label>Verification and Test Capability Kind</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#VerificationTraceabilityCapability -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#VerificationTraceabilityCapability">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#DEEnvironmentCapability"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>Emergent environment capability: the environment has both a requirements management tool and a V&amp;T tool connected (via shared integration hub or directly), enabling end-to-end traceability from test result back to requirement.</dc:description>
        <rdfs:label>Verification Traceability Capability</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Rules
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <rdf:Description rdf:about="urn:swrl:var#r">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="urn:swrl:var#s">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="urn:swrl:var#t">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="urn:swrl:var#env">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="urn:swrl:var#tool">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="urn:swrl:var#integ">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description>
        <rdfs:label>hasInstalledTool derivation</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#HasInstalledTool"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://opencaesar.io/oml#hasSource"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#s"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://opencaesar.io/oml#hasTarget"/>
                                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                        <swrl:argument2 rdf:resource="urn:swrl:var#t"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment#hasInstalledTool"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                        <swrl:argument2 rdf:resource="urn:swrl:var#t"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <rdfs:label>hasSourceTool derivation</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
