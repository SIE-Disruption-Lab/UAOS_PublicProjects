    <!-- http://uaontologies.com/UAOS_Domain/UAOS_SystemArchitecture#canBeInputOf -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_SystemArchitecture#canBeInputOf">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_SystemArchitecture#canInput"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Continuant"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Function"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_SystemArchitecture#CanInput"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>can be input of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_SystemArchitecture#canBeOutputOf -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_SystemArchitecture#canBeOutputOf">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_SystemArchitecture#canOutput"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Continuant"/>
