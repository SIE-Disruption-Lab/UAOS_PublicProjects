        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>executes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_SystemArchitecture#interactsWith -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_SystemArchitecture#interactsWith">
