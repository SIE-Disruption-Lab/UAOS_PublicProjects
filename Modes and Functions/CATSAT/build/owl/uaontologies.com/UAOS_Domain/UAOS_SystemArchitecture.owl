    <!-- http://uaontologies.com/UAOS_Domain/UAOS_SystemArchitecture#executedBy -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_SystemArchitecture#executedBy">
        <rdfs:subPropertyOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Event#hasParticipant"/>
