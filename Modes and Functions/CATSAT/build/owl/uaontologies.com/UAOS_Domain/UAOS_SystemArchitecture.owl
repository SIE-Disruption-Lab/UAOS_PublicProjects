    <!-- http://uaontologies.com/UAOS_Domain/UAOS_SystemArchitecture#ExternalEntity -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_SystemArchitecture#ExternalEntity">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Role"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#sdo"/>
                <owl:someValuesFrom rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#IndependentContinuant"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=ExternalEntity=]...</dc:description>
        <rdfs:label>External Entity</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_SystemArchitecture#FunctionOccurrence -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_SystemArchitecture#FunctionOccurrence">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Process"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Event#isManifestationOf"/>
                <owl:someValuesFrom rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Function"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Event#isManifestationOf"/>
                <owl:allValuesFrom rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Function"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasOccurrentPart"/>
                <owl:allValuesFrom rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_SystemArchitecture#FunctionOccurrence"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#isOccurrentPartOf"/>
                <owl:allValuesFrom rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_SystemArchitecture#FunctionOccurrence"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=FunctionOccurrence=]...</dc:description>
        <rdfs:label>Function Occurrence</rdfs:label>
    </owl:Class>
    


