        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Assessment#AssessmentFinding"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Assessment#HasFinding"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>has finding</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Assessment#milestoneTracedToBy -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Assessment#milestoneTracedToBy">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Assessment#tracesToMilestone"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
