        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Assessment#HasFinding"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>finding of</rdfs:label>
    </owl:ObjectProperty>
    


