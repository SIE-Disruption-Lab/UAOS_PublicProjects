     -->


    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Assessment#confidenceScore -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Assessment#confidenceScore">
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Assessment#AssessmentFinding"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <dc:description>[=confidenceScore=] captures the analytical or AI-generated confidence in an AssessmentFinding, expressed as a value in [0.0, 1.0] where 1.0 indicates maximum confidence.</dc:description>
        <rdfs:label>confidence score</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Assessment#AssessmentFinding -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Assessment#AssessmentFinding">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#PrescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>An [=AssessmentFinding=] is a PrescriptiveICE that prescribes a recommended action or records a significant judgement arising from a program review or T&amp;E assessment. It may carry a confidence score when generated analytically or by AI-assisted assessment tools. The text of the finding is captured via tlo:hasNaturalLanguageDescription.</dc:description>
        <rdfs:label>Assessment Finding</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Assessment#DTOTCreditCriterion -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Assessment#DTOTCreditCriterion">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#PrescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=DTOTCreditCriterion=] is a PrescriptiveICE that specifies one of the criteria by which developmental test (DT) data may be credited toward operational test (OT) evaluation. The six canonical criteria (DTOT-01 through DTOT-06) address scenario realism, operator involvement, production configuration, data independence, pre-agreed protocols, and statistical adequacy.</dc:description>
        <rdfs:label>DTOT Credit Criterion</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Assessment#HasFinding -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Assessment#HasFinding">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasFinding=] relates a ProgramMilestone to an AssessmentFinding that arises from its review — capturing the recommendations and significant judgements recorded at that gate.</dc:description>
        <rdfs:label>Has Finding</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Assessment#ProgramMilestone -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Assessment#ProgramMilestone">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Process"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=ProgramMilestone=] is a Process constituting a formal program review gate at which readiness to proceed to the next acquisition or T&amp;E phase is assessed. Examples include System Functional Review (SFR), Preliminary Design Review (PDR), Critical Design Review (CDR), Integrated Test Readiness Assessment (ITRA), and Milestone decisions (MS-A, MS-B, MS-C, FRP). ProgramMilestone is a Process because it is an event that unfolds over time and has participating reviewers and artefacts.</dc:description>
        <rdfs:label>Program Milestone</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Assessment#SatisfiesDTOTCriterion -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Assessment#SatisfiesDTOTCriterion">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=SatisfiesDTOTCriterion=] relates a Test to a DTOTCreditCriterion that it satisfies, recording which DT/OT integration criteria are met by a given test event.</dc:description>
        <rdfs:label>Satisfies DTOT Criterion</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Assessment#TracesToMilestone -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Assessment#TracesToMilestone">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=TracesToMilestone=] relates a VerificationActivity (including Tests, Inspections, Demonstrations, and Analyses) to the ProgramMilestone toward which its results contribute. Establishes the traceability link between individual test events and the program review gate they support.</dc:description>
        <rdfs:label>Traces To Milestone</rdfs:label>
    </owl:Class>
    


