     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:UAOS_Assessment="http://uaontologies.com/UAOS_Domain/UAOS_Assessment#">
    <owl:Ontology rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Assessment">
        <owl:imports rdf:resource="http://purl.org/dc/elements/1.1"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Test"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Verification"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel"/>
        <oml:namespace rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Assessment#"/>
        <oml:prefix>UAOS_Assessment</oml:prefix>
        <oml:type rdf:resource="http://opencaesar.io/oml#Vocabulary"/>
        <dc:contributor>Joe Gregory</dc:contributor>
        <dc:contributor>Paul Wach</dc:contributor>
        <dc:creator>SIE Disruption Lab</dc:creator>
        <dc:description>A vocabulary to capture T&amp;E assessment patterns, including program review milestones, assessment findings, and DT/OT credit criteria.</dc:description>
        <dc:hasVersion>0.1</dc:hasVersion>
    </owl:Ontology>
    


