        <oml:namespace rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#"/>
        <oml:prefix>UAOS_MissionEngineering</oml:prefix>
        <oml:type rdf:resource="http://opencaesar.io/oml#Vocabulary"/>
        <dc:contributor>Hunter Fiore</dc:contributor>
        <dc:contributor>Joe Gregory</dc:contributor>
        <dc:creator>SIE Disruption Lab</dc:creator>
        <dc:description>A vocabulary capturing Mission Engineering concepts aligned with the strategic, operational, and resource layers of UAF, corrected for BFO/UAOS ontological compliance.</dc:description>
        <dc:hasVersion>0.4</dc:hasVersion>
    </owl:Ontology>
    


