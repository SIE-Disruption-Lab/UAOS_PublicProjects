    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#AchievesEffect -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#AchievesEffect">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=AchievesEffect=] relates a Mission to the DesiredEffect it is intended to bring about — the strategic intent link connecting mission execution to its specified outcome.</dc:description>
        <rdfs:label>AchievesEffect</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#AllocatesCapability -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#AllocatesCapability">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=AllocatesCapability=] relates a MissionEngineeringThread to the CapabilityConfiguration it allocates for execution — specifying which specific resource arrangement is assigned to deliver the capability required by the MissionThread.</dc:description>
        <rdfs:label>AllocatesCapability</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ArisesFrom -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ArisesFrom">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=ArisesFrom=] relates an Opportunity to the Challenge from which it arises.</dc:description>
        <rdfs:label>ArisesFrom</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#AssignedTo -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#AssignedTo">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=AssignedTo=] relates an EnterpriseGoal to the StrategicPhase to which it is assigned.</dc:description>
        <rdfs:label>AssignedTo</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#BoundedByEpoch -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#BoundedByEpoch">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=BoundedByEpoch=] relates a Scenario to the Epoch that bounds the time interval during which its conditions are held constant.</dc:description>
        <rdfs:label>BoundedByEpoch</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#Capability -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#Capability">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Disposition"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=Capability=] is a Disposition that inheres in a specific agent or system, enabling it to perform a class of operational activities under specified conditions. Capability is specifically dependent on its bearer (an SDCCarrier such as an OperationalPerformer). It satisfies a CapabilityRequirement when the bearer possesses the relevant functional basis. When executed, the Capability manifestsIn a MissionEngineeringThread or ResourceService (via event:manifestsIn). DISTINCTION: CapabilityRequirement is the desire/specification (no bearer); Capability is the actual disposition (requires a bearer).</dc:description>
        <rdfs:label>Capability</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#CapabilityConfiguration -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#CapabilityConfiguration">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#DescriptiveICE"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#describes"/>
                <owl:someValuesFrom rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#Capability"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=CapabilityConfiguration=] is a DescriptiveICE that describes a specific arrangement of resources — their types, quantities, and interconnections — that together realise one or more Capabilities. It is a descriptive information entity because configuration is a pattern or description; the physical resources described by it carry the actual dispositions.</dc:description>
        <rdfs:label>CapabilityConfiguration</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#CapabilityRequirement -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#CapabilityRequirement">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Requirements#Requirement"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=CapabilityRequirement=] is a PrescriptiveICE specifying a capability the enterprise requires to achieve a DesiredEffect. It is a type-level specification — generically dependent, requiring no specific bearer — and is satisfied when a corresponding Capability disposition is instantiated in an appropriate agent or system.</dc:description>
        <rdfs:label>CapabilityRequirement</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#CarriesOperationalInformation -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#CarriesOperationalInformation">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=CarriesOperationalInformation=] relates an OperationalExchange to the OperationalInformation it carries.</dc:description>
        <rdfs:label>CarriesOperationalInformation</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#CarriesResourceInformation -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#CarriesResourceInformation">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=CarriesResourceInformation=] relates a ResourceExchange to the ResourceInformation it carries.</dc:description>
        <rdfs:label>CarriesResourceInformation</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#Challenge -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#Challenge">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#DescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=Challenge=] is a DescriptiveICE that describes an adverse condition or obstacle presented by a Driver that the enterprise must address in pursuing its goals. It is an information entity — a description of a problematic state of affairs — not a process or disposition.</dc:description>
        <rdfs:label>Challenge</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ComposedOfActivity -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ComposedOfActivity">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#HasContinuantPart"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=ComposedOfActivity=] relates a KillChain to an OperationalActivity that is one of its prescribed steps — enabling traceability from kill chain steps to specific operational activities and their capability requirements. Sub-relation of tlo:HasContinuantPart (both KillChain and OperationalActivity are PrescriptiveICEs, i.e., GenericallyDependentContinuants).</dc:description>
        <rdfs:label>ComposedOfActivity</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#CorrespondsToDesiredEffect -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#CorrespondsToDesiredEffect">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=CorrespondsToDesiredEffect=] relates an actual Effect to the DesiredEffect it fulfils or partially fulfils — the assessment link connecting what was achieved to what was intended. This relation is the basis for mission effectiveness evaluation.</dc:description>
        <rdfs:label>CorrespondsToDesiredEffect</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#DefinedFor -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#DefinedFor">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=DefinedFor=] relates an EnterpriseVision to the StrategicPhase for which it prescribes an intended future state.</dc:description>
        <rdfs:label>DefinedFor</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#Depicts -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#Depicts">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=Depicts=] relates a Scenario to the Mission it describes — the Scenario is a DescriptiveICE characterising the context, forces, objectives, and constraints of a specific Mission situation.</dc:description>
        <rdfs:label>Depicts</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#DesiredEffect -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#DesiredEffect">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#DescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=DesiredEffect=] is a DescriptiveICE that describes a state of affairs the enterprise wishes to bring about through mission execution. DesiredEffects represent intended outcomes at the strategic/operational boundary and provide the motivating rationale for Missions and CapabilityRequirements. DISTINCTION: DesiredEffect is the information entity specifying the change that is wanted; Effect is the actual change event (a Process).</dc:description>
        <rdfs:label>DesiredEffect</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#Driver -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#Driver">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#DescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=Driver=] is a DescriptiveICE that describes a force — internal or external — that motivates or compels strategic change, giving rise to Challenges and Opportunities. Examples: a competitive threat, a regulatory mandate, a technological shift. Classified as DescriptiveICE (not Role) because a Driver is an information entity describing a causal factor, not a role played by an entity.</dc:description>
        <rdfs:label>Driver</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#Effect -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#Effect">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Process"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>An [=Effect=] is a Process constituting an actual change brought about in the operational environment through mission execution. It is an occurrent — a change event that unfolds in time — not a description of one. DISTINCTION: Effect (this class) is the actual causal occurrence; DesiredEffect is the information entity specifying the change that is wanted. A Mission ProducesEffect an Effect, and that Effect may CorrespondToDesiredEffect one or more DesiredEffects.</dc:description>
        <rdfs:label>Effect</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#EnterpriseGoal -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#EnterpriseGoal">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#PrescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>An [=EnterpriseGoal=] is a PrescriptiveICE that prescribes a strategic outcome the enterprise seeks to achieve within a StrategicPhase. Enterprise goals are motivated by Drivers and give rise to CapabilityRequirements.</dc:description>
        <rdfs:label>EnterpriseGoal</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#EnterpriseObjective -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#EnterpriseObjective">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#EnterpriseGoal"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>An [=EnterpriseObjective=] is an EnterpriseGoal that is specific, measurable, and time-bounded — a concrete milestone that operationalises a broader enterprise goal.</dc:description>
        <rdfs:label>EnterpriseObjective</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#EnterpriseVision -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#EnterpriseVision">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#PrescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>An [=EnterpriseVision=] is a PrescriptiveICE that prescribes an intended future state of the enterprise. It provides the overarching strategic intent that bounds enterprise goals and missions. It has no specific bearer (generically dependent) — it is a specification, not a realised state.</dc:description>
        <rdfs:label>EnterpriseVision</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#Environment -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#Environment">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#IndependentContinuant"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>An [=Environment=] is an IndependentContinuant comprising the entities — terrain, adversaries, infrastructure, weather systems, airspace, electromagnetic spectrum, cyberspace — that constitute the operational context within which a Mission is conducted. Classified as IndependentContinuant (not ObjectAggregate) to allow both material and immaterial components as parts without the MaterialEntity-only part restriction that ObjectAggregate imposes.</dc:description>
        <rdfs:label>Environment</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#Epoch -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#Epoch">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#TemporalRegion"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>An [=Epoch=] is a TemporalRegion bounding the time interval during which the conditions of a Scenario remain constant. When scenario conditions change — due to capability introduction, environmental change, or operational phase transition — a new Epoch begins. Epochs allow a model to capture before/during/after states without creating separate Scenario instances for each condition. Reference: DoD MEG v2.</dc:description>
        <rdfs:label>Epoch</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ExchangeViaPort -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ExchangeViaPort">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=ExchangeViaPort=] relates an OperationalExchange to the OperationalPort through which it flows.</dc:description>
        <rdfs:label>ExchangeViaPort</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ForceDesignation -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ForceDesignation">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Role"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=ForceDesignation=] is a Role played by an OperationalPerformer within the context of a specific Mission or Scenario that designates its adversarial or cooperative standing. Canonical designations: Blue (friendly), Red (adversary), Green (neutral/host nation). ForceDesignation is context-dependent: the same OperationalPerformer may play different ForceDesignation roles in different Scenarios.</dc:description>
        <rdfs:label>ForceDesignation</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#HasCapabilityRequirement -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#HasCapabilityRequirement">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasCapabilityRequirement=] relates an EnterpriseGoal to the CapabilityRequirement it generates — the key traceability link connecting strategic intent to capability planning.</dc:description>
        <rdfs:label>HasCapabilityRequirement</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#HasEnvironment -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#HasEnvironment">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasEnvironment=] relates a Mission to the Environment within which it is conducted.</dc:description>
        <rdfs:label>HasEnvironment</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#HasForceDesignation -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#HasForceDesignation">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasForceDesignation=] relates an OperationalPerformer to the ForceDesignation Role it plays in the context of a given Mission or Scenario — asserting the performer&apos;s adversarial or cooperative standing (Blue, Red, or Green).</dc:description>
        <rdfs:label>HasForceDesignation</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#HasKillChain -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#HasKillChain">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#HasContinuantPart"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasKillChain=] relates a KillWeb to a KillChain that is a component part of it. Sub-relation of tlo:HasContinuantPart (both KillWeb and KillChain are GenericallyDependentContinuants). Direction: KillWeb hasContinuantPart KillChain, consistent with figure conventions.</dc:description>
        <rdfs:label>HasKillChain</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#HasMission -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#HasMission">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#HasOccurrentPart"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasMission=] relates a StrategicPhase to the Missions that are its temporal parts. Sub-relation of tlo:HasOccurrentPart (both domain and range are Processes).</dc:description>
        <rdfs:label>HasMission</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#HasMissionPhase -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#HasMissionPhase">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#HasOccurrentPart"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasMissionPhase=] relates a Mission to a MissionPhase that is a temporal part of it. Sub-relation of tlo:HasOccurrentPart (both domain and range are Processes).</dc:description>
        <rdfs:label>HasMissionPhase</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#HasMissionThread -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#HasMissionThread">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasMissionThread=] relates a Mission (Process) to a MissionThread (PrescriptiveICE) that it executes. This is a cross-category relation between an Occurrent and a GenericallyDependentContinuant; no BFO mereological parent applies across these categories.</dc:description>
        <rdfs:label>HasMissionThread</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#HasOperation -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#HasOperation">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#HasOccurrentPart"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasOperation=] relates a StrategicPhase to an Operation that is its temporal part. Sub-relation of tlo:HasOccurrentPart (both domain and range are Processes).</dc:description>
        <rdfs:label>HasOperation</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ImplementsExchange -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ImplementsExchange">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=ImplementsExchange=] relates a ResourceExchange to the OperationalExchange it implements — the resource-level realisation of an operational-level exchange.</dc:description>
        <rdfs:label>ImplementsExchange</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ImplementsMissionThread -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ImplementsMissionThread">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=ImplementsMissionThread=] relates a MissionEngineeringThread (solution-specific) to the MissionThread (solution-agnostic) it implements — the core traceability link between solution-agnostic mission design and solution-specific mission architecture. Multiple METs (Baseline, Alternative, Excursion) may implement the same MissionThread.</dc:description>
        <rdfs:label>ImplementsMissionThread</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#IncludesInForce -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#IncludesInForce">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=IncludesInForce=] relates an OrderOfBattle to the OperationalPerformerSpecs it describes as members of the force structure. Range is OperationalPerformerSpec (the planning-level slot) because an OrderOfBattle is a DescriptiveICE that describes which performer slots are planned, not which specific role tokens are filled.</dc:description>
        <rdfs:label>IncludesInForce</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#IsCapableToPerform -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#IsCapableToPerform">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=IsCapableToPerform=] relates an OperationalPerformer to the OperationalActivity it is capable of performing, grounded in its Capability dispositions.</dc:description>
        <rdfs:label>IsCapableToPerform</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#KillChain -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#KillChain">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#PrescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=KillChain=] is a PrescriptiveICE that prescribes a structured, ordered sequence of OperationalActivities constituting a complete targeting or effects-delivery process. The canonical DoD kill chain is F2T2EA (Find, Fix, Track, Target, Engage, Assess). A KillChain is a prescriptive specification — the actual executions of its steps are OperationalActivityActions. KillChains may be composed into a KillWeb.</dc:description>
        <rdfs:label>KillChain</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#KillWeb -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#KillWeb">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#DescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=KillWeb=] is a DescriptiveICE that describes a network of interconnected KillChains, sensors, shooters, and command nodes that collectively provide redundant and distributed effects-delivery capability across multiple operational domains. Unlike the linear KillChain, the KillWeb describes actual networked capability relationships and is therefore descriptive rather than prescriptive.</dc:description>
        <rdfs:label>KillWeb</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#KnownResource -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#KnownResource">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Role"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=KnownResource=] is a Role representing a generic resource type known to be required for an OperationalActivity but whose specific physical instantiation has not yet been identified. It is a planning-level construct — a role placeholder, not a material entity. NOTE: not a subtype of OperationalPerformer; it is the role that a future resource will play.</dc:description>
        <rdfs:label>KnownResource</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#MapsToCapability -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#MapsToCapability">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=MapsToCapability=] relates an OperationalActivity specification to the Capability required to execute it, establishing traceability between the operational specification layer and the resource disposition layer.</dc:description>
        <rdfs:label>MapsToCapability</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#Mission -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#Mission">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Process"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=Mission=] is a bounded, goal-directed Process prosecuted by one or more agents against an operational Environment to achieve DesiredEffects. Mission is classified as a Process because it unfolds over time, has temporal parts (MissionPhases, MissionThreads), and is realised by participating agents. NOTE: supersedes the bare tlo:Occurrent classification in UAOS_Mission.oml.</dc:description>
        <rdfs:label>Mission</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#MissionEngineeringThread -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#MissionEngineeringThread">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Process"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=MissionEngineeringThread=] (MET) is a Process that is a solution-specific realisation of a MissionThread: it specifies which CapabilityConfigurations (systems, organisations, and resources) are allocated to execute the mission activities. The MissionThread says what must happen; the MissionEngineeringThread says which systems will do it and how. Multiple METs (Baseline, Alternative, Excursion) may implement the same MissionThread, enabling architectural trade-space analysis. NOTE: UAF DMM v1.2 classifies MET as a &apos;generalisation of Function&apos; — this is an ontological error (Function is a Disposition/SDC; it cannot be executed). This classification corrects that error: MET is a Process (occurrent).</dc:description>
        <rdfs:label>MissionEngineeringThread</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#MissionPhase -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#MissionPhase">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Process"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=MissionPhase=] is a temporally bounded Process that is a temporal part of a Mission, representing a distinct period of mission execution characterised by a coherent set of activities and objectives. Example phases: ingress, engagement, egress. MissionPhases partition the Mission timeline and may contain MissionThreads as sub-processes.</dc:description>
        <rdfs:label>MissionPhase</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#MissionTask -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#MissionTask">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#MissionThread"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=MissionTask=] is an atomic MissionThread — a minimal, indivisible unit of prescribed mission activity that cannot be further decomposed into finer-grained MissionThread specifications.</dc:description>
        <rdfs:label>MissionTask</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#MissionThread -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#MissionThread">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#PrescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=MissionThread=] is a PrescriptiveICE that prescribes an end-to-end mission execution sequence as an ordered set of OperationalActivities, independent of which systems or capability configurations perform them. MissionThreads are solution-agnostic specifications: they define what must happen without identifying how. Solution-specific realisation is captured by MissionEngineeringThread (a Process) via ImplementsMissionThread.</dc:description>
        <rdfs:label>MissionThread</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#MotivatedBy -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#MotivatedBy">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=MotivatedBy=] relates an EnterpriseGoal to the Driver that motivates it.</dc:description>
        <rdfs:label>MotivatedBy</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#NaturalResource -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#NaturalResource">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#PhysicalResource"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=NaturalResource=] is a PhysicalResource whose existence is not the result of deliberate human manufacture — e.g. a geographical feature, terrain, or environmental phenomenon exploited in mission execution.</dc:description>
        <rdfs:label>NaturalResource</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#Operation -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#Operation">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Process"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>An [=Operation=] is a Process comprising a coordinated set of Missions conducted in a common operational area toward a unified military objective. Operations are temporal parts of a StrategicPhase and are temporal wholes of which Missions may be parts. Example: Operation DESERT STORM is the strategic operation containing the individual raid missions of Task Force Normandy.</dc:description>
        <rdfs:label>Operation</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#OperationalActivity -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#OperationalActivity">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#PrescriptiveICE"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#prescribes"/>
                <owl:allValuesFrom rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Process"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>An [=OperationalActivity=] is a PrescriptiveICE that specifies a coherent unit of work to be performed in pursuit of a mission objective. It is a type-level construct — a specification — not a concrete process execution. Executions are OperationalActivityActions. This resolves the UAF type/token conflation, mirroring the UAOS Plan/ManagedProcess pattern.</dc:description>
        <rdfs:label>OperationalActivity</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#OperationalActivityAction -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#OperationalActivityAction">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Process"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#isPrescribedBy"/>
                <owl:someValuesFrom rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#OperationalActivity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>An [=OperationalActivityAction=] is a Process constituting a concrete execution of an OperationalActivity specification. It is the token-level counterpart of the type-level OperationalActivity and is related to its prescribing OperationalActivity via info:isPrescribedBy.</dc:description>
        <rdfs:label>OperationalActivityAction</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#OperationalExchange -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#OperationalExchange">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Process"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>An [=OperationalExchange=] is a Process representing the transfer of operationally significant items — information, materiel, energy, or services — between OperationalPerformers via OperationalPorts.</dc:description>
        <rdfs:label>OperationalExchange</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#OperationalInformation -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#OperationalInformation">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#InformationContentEntity"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>An [=OperationalInformation=] is an InformationContentEntity carried by or exchanged between OperationalPerformers during an OperationalExchange.</dc:description>
        <rdfs:label>OperationalInformation</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#OperationalInterface -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#OperationalInterface">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Interfaces#InterfaceType"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#prescribes"/>
                <owl:allValuesFrom rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#OperationalPort"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>An [=OperationalInterface=] is an InterfaceType that specifies the protocol, format, and constraints for an OperationalExchange between OperationalPorts. Narrows the iface:InterfaceType prescribes target to OperationalPort.</dc:description>
        <rdfs:label>OperationalInterface</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#OperationalPerformer -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#OperationalPerformer">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Role"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#sdo"/>
                <owl:someValuesFrom rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#MaterialEntity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>An [=OperationalPerformer=] is a Role played by a MaterialEntity in the context of a Mission — the role of being an agent that executes operational activities. OperationalPerformer is specifically dependent on its bearer (a tlo:MaterialEntity such as a system, platform, or organisation). DISTINCTION: OperationalPerformerSpec (&lt; PrescriptiveICE) is the planning-level specification of a required performer slot, requiring no bearer; OperationalPerformer (this class) is the execution-level role token, instantiated when a specific MaterialEntity is assigned to fill the slot. Mirrors the OperationalActivity (spec) / OperationalActivityAction (token) pattern.</dc:description>
        <rdfs:label>OperationalPerformer</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#OperationalPerformerSpec -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#OperationalPerformerSpec">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#PrescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>An [=OperationalPerformerSpec=] is a PrescriptiveICE that specifies a required performer slot in a Mission or OperationalActivity — prescribing the role to be played — without yet identifying the specific MaterialEntity that will fill it. It is a planning-level construct: generically dependent, requiring no bearer. When a specific system or platform is assigned, an OperationalPerformer role token is created with the material entity as its bearer. PATTERN: mirrors OperationalActivity (spec, PrescriptiveICE) / OperationalActivityAction (token, Process). NOTE: previously, OperationalPerformer was classified as tlo:MaterialEntity, which forced a bearer at the planning stage. This class resolves that gap.</dc:description>
        <rdfs:label>OperationalPerformerSpec</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#OperationalPort -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#OperationalPort">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Interfaces#Port"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>An [=OperationalPort=] is a Port belonging to an OperationalPerformer through which an OperationalExchange flows. It specialises iface:Port to the operational domain.</dc:description>
        <rdfs:label>OperationalPort</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#OperationalRole -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#OperationalRole">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Role"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>An [=OperationalRole=] is a Role played by an agent in the context of an OperationalActivity. It specifies the function a performer is expected to fulfil without identifying a specific performer instance.</dc:description>
        <rdfs:label>OperationalRole</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#Opportunity -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#Opportunity">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#DescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>An [=Opportunity=] is a DescriptiveICE that describes a favourable circumstance or potential advantage that arises from a Driver or Challenge and that could be exploited to advance enterprise goals. It is an information entity — a description of a beneficial possibility — not a realised capability.</dc:description>
        <rdfs:label>Opportunity</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#Opposes -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#Opposes">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=Opposes=] relates two OperationalPerformers in an adversarial relationship. Symmetric: if A opposes B then B opposes A.</dc:description>
        <rdfs:label>Opposes</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#OrderOfBattle -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#OrderOfBattle">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#DescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>An [=OrderOfBattle=] is a DescriptiveICE that describes the composition, organisation, and disposition of forces involved in an Operation or Mission — specifying which OperationalPerformers are present, their command relationships, and their assigned roles.</dc:description>
        <rdfs:label>OrderOfBattle</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ParticipatesInMission -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ParticipatesInMission">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Event#HasParticipant"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=ParticipatesInMission=] relates a Mission to the OperationalPerformers that participate in it. Sub-relation of event:HasParticipant (Mission &lt; Occurrent ✓; OperationalPerformer &lt; MaterialEntity &lt; Continuant ✓).</dc:description>
        <rdfs:label>ParticipatesInMission</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#PerformsInContext -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#PerformsInContext">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=PerformsInContext=] relates an OperationalRole to the OperationalActivity that defines the context in which that role performs.</dc:description>
        <rdfs:label>PerformsInContext</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#PhysicalResource -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#PhysicalResource">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ResourcePerformer"/>
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#MaterialEntity"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=PhysicalResource=] is a MaterialEntity with the ResourcePerformer aspect — a tangible, physical entity (platform, vehicle, sensor, or human) that performs resource-level functions.</dc:description>
        <rdfs:label>PhysicalResource</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#PresentedBy -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#PresentedBy">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=PresentedBy=] relates a Challenge to the Driver that presents or gives rise to it.</dc:description>
        <rdfs:label>PresentedBy</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ProducesEffect -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ProducesEffect">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Event#Causes"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=ProducesEffect=] relates a Mission to an actual Effect — a change event — that the Mission produces in the operational environment. DISTINCTION: AchievesEffect relates Mission to the desired specification (DesiredEffect &lt; DescriptiveICE); ProducesEffect relates Mission to the actual occurrence (Effect &lt; Process). Sub-relation of event:Causes (Mission &lt; tlo:Process ✓; Effect &lt; tlo:Process ✓).</dc:description>
        <rdfs:label>ProducesEffect</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#RealisesActivity -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#RealisesActivity">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=RealisesActivity=] relates a ResourceService to the OperationalActivity it realises — traceability from physical resource behaviour to operational specification.</dc:description>
        <rdfs:label>RealisesActivity</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ResourceArtifact -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ResourceArtifact">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ResourcePerformer"/>
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Object"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=ResourceArtifact=] is a designed or manufactured Object with the ResourcePerformer aspect — a human-made physical resource (platform, weapon system, sensor, communication node) employed in mission execution.</dc:description>
        <rdfs:label>ResourceArtifact</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ResourceConnector -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ResourceConnector">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Object"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=ResourceConnector=] is a physical Object that connects two ResourcePorts, providing the material substrate over which a ResourceExchange occurs.</dc:description>
        <rdfs:label>ResourceConnector</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ResourceExchange -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ResourceExchange">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Process"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=ResourceExchange=] is a Process that implements an OperationalExchange at the resource level — the concrete transfer of materiel, energy, information, or services between physical resources.</dc:description>
        <rdfs:label>ResourceExchange</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ResourceFunction -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ResourceFunction">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Function"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=ResourceFunction=] is a Function that inheres in a physical resource and represents the designed or assigned functional capacity of that resource to perform a specific class of resource-level activity.</dc:description>
        <rdfs:label>ResourceFunction</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ResourceInformation -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ResourceInformation">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#InformationContentEntity"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=ResourceInformation=] is an InformationContentEntity carried by or exchanged between resource performers at the resource level.</dc:description>
        <rdfs:label>ResourceInformation</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ResourceInterface -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ResourceInterface">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Interfaces#InterfaceType"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#prescribes"/>
                <owl:allValuesFrom rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ResourcePort"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=ResourceInterface=] is an InterfaceType that specifies the constraints for a ResourceExchange between ResourcePorts. Narrows the iface:InterfaceType prescribes target to ResourcePort.</dc:description>
        <rdfs:label>ResourceInterface</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ResourcePerformer -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ResourcePerformer">
        <oml:type rdf:resource="http://opencaesar.io/oml#Aspect"/>
        <dc:description>A [=ResourcePerformer=] is a mixin aspect marking an entity as capable of performing operational activities at the resource (physical/system) level. Useful as a query tag across heterogeneous resource types.</dc:description>
        <rdfs:label>ResourcePerformer</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ResourcePort -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ResourcePort">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Interfaces#Port"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=ResourcePort=] is a Port belonging to a PhysicalResource or ResourceArtifact through which a ResourceExchange flows.</dc:description>
        <rdfs:label>ResourcePort</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ResourceRole -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ResourceRole">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#OperationalRole"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=ResourceRole=] is an OperationalRole played at the resource level — a role assigned to a physical or organisational resource within a resource architecture.</dc:description>
        <rdfs:label>ResourceRole</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ResourceService -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#ResourceService">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Process"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=ResourceService=] is a Process representing a discrete, defined service delivered by a resource to support mission execution — the resource-level realisation of an OperationalActivity.</dc:description>
        <rdfs:label>ResourceService</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#SatisfiesCapabilityRequirement -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#SatisfiesCapabilityRequirement">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=SatisfiesCapabilityRequirement=] relates a Capability (an actual disposition inhering in a specific bearer) to the CapabilityRequirement (a specification) it satisfies — the traceability bridge from desired to actual capability.</dc:description>
        <rdfs:label>SatisfiesCapabilityRequirement</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#Scenario -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#Scenario">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#DescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=Scenario=] is a DescriptiveICE that describes a hypothetical or anticipated situation — including the operational environment, forces, objectives, constraints, and context — within which a Mission or set of Missions is analysed or executed. A Scenario is an information entity: it exists as a description even when the situation it describes has not yet been enacted. The Scenario hierarchy (Scenario → Operation → Vignette → Mission → MissionThread → MET) structures the analytical decomposition of mission architecture. Reference: DoD MEG v2; Mission Architecture Style Guide.</dc:description>
        <rdfs:label>Scenario</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#StrategicPhase -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#StrategicPhase">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Process"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=StrategicPhase=] is a temporally bounded phase of enterprise-level activity comprising one or more Operations or Missions directed toward a common strategic intent. It is a Process because it unfolds over time and has Operations and Missions as temporal parts.</dc:description>
        <rdfs:label>StrategicPhase</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#TargetsEffect -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#TargetsEffect">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=TargetsEffect=] relates a CapabilityRequirement to the DesiredEffect it aims to achieve, establishing traceability from capability planning to intended mission outcomes.</dc:description>
        <rdfs:label>TargetsEffect</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#Vignette -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#Vignette">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#Scenario"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=Vignette=] is a Scenario that is focused on a specific, bounded operational situation — a targeted slice of a larger Scenario used to analyse a particular aspect of mission execution, such as a specific force interaction or timeline segment. Example: the Task Force Normandy SEAD raid is a Vignette within the Operation DESERT STORM Scenario.</dc:description>
        <rdfs:label>Vignette</rdfs:label>
    </owl:Class>
    


