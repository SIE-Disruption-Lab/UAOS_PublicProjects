    <!-- http://uaontologies.com/UAOS_Domain/UAOS_States#EnteredBy -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_States#EnteredBy">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_States#ExitedBy -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_States#ExitedBy">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_States#Incorporates -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_States#Incorporates">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_States#State -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_States#State">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Disposition"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasContinuantPart"/>
                <owl:allValuesFrom rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_States#State"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#isContinuantPartOf"/>
                <owl:allValuesFrom rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_States#State"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_States#Transition -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_States#Transition">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Function"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_States#TransitionOccurrence -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_States#TransitionOccurrence">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Process"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Event#isManifestationOf"/>
                <owl:someValuesFrom rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_States#Transition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Event#isManifestationOf"/>
                <owl:allValuesFrom rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_States#Transition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasOccurrentPart"/>
                <owl:allValuesFrom rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_States#TransitionOccurrence"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#isOccurrentPartOf"/>
                <owl:allValuesFrom rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_States#TransitionOccurrence"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_States#TriggeredBy -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_States#TriggeredBy">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
    </owl:Class>
    


