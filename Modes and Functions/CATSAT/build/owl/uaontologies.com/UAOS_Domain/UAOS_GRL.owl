<?xml version="1.0"?>
<rdf:RDF xmlns="http://uaontologies.com/UAOS_Domain/UAOS_GRL#"
     xml:base="http://uaontologies.com/UAOS_Domain/UAOS_GRL"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:oml="http://opencaesar.io/oml#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:UAOS_GRL="http://uaontologies.com/UAOS_Domain/UAOS_GRL#">
    <owl:Ontology rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_GRL">
        <owl:imports rdf:resource="http://purl.org/dc/elements/1.1"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information"/>
        <oml:namespace rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_GRL#"/>
        <oml:prefix>UAOS_GRL</oml:prefix>
        <oml:type rdf:resource="http://opencaesar.io/oml#Vocabulary"/>
        <dc:contributor>Joe Gregory</dc:contributor>
        <dc:contributor>Paul Wach</dc:contributor>
        <dc:creator>SIE Disruption Lab</dc:creator>
        <dc:description>A vocabulary defining the General Readiness Level (GRL) scale and the four assessment axes of the 4D Assessment framework. GRL is a domain-agnostic 9-level readiness framework (Foundation 1-3, Development 4-6, Operational 7-9) from which all existing readiness level frameworks are recoverable via thread restriction. The four assessment axes (Evidence D1, System Readiness D2, Governance D3, Product Quality D4) are the scoring dimensions of the 4D Assessment methodology. Source: WRT-2516 v2, Chapters 6-8.</dc:description>
        <dc:hasVersion>0.1</dc:hasVersion>
    </owl:Ontology>
    


