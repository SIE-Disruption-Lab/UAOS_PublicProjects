        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#ApplicationComponent"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#ApplicationService"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#Provides"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>provides</rdfs:label>
    </owl:ObjectProperty>
    


