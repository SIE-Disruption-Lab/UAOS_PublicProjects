    <!-- http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#hasMemberOrganisation -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#hasMemberOrganisation">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#EngineeringProgramme"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Agent#Organization"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#HasMemberOrganisation"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>has member organisation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#hostedOn -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#hostedOn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#ApplicationComponent"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#TechnologyPlatform"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#HostedOn"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>hosted on</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#hosts -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#hosts">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#hostedOn"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#TechnologyPlatform"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#ApplicationComponent"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#HostedOn"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>hosts</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#isMemberOfProgramme -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#isMemberOfProgramme">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#hasMemberOrganisation"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Agent#Organization"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#EngineeringProgramme"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#HasMemberOrganisation"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>is member of programme</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#isProvidedBy -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#isProvidedBy">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#provides"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#ApplicationService"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#ApplicationComponent"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#Provides"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>is provided by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#provides -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#provides">
