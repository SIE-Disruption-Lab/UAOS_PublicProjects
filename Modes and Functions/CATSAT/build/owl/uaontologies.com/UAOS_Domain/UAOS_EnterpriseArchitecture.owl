<?xml version="1.0"?>
<rdf:RDF xmlns="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#"
     xml:base="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:oml="http://opencaesar.io/oml#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:UAOS_EA="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#">
    <owl:Ontology rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture">
        <owl:imports rdf:resource="http://purl.org/dc/elements/1.1"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Agent"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel"/>
        <oml:namespace rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#"/>
        <oml:prefix>UAOS_EA</oml:prefix>
        <oml:type rdf:resource="http://opencaesar.io/oml#Vocabulary"/>
        <dc:contributor>Joe Gregory</dc:contributor>
        <dc:creator>SIE Disruption Lab</dc:creator>
        <dc:description>A minimal Enterprise Architecture vocabulary for the UAOS. Captures the concepts needed to model organisational structure, application components and services, and programme membership. Inspired by ArchiMate 3.2 (Business and Application layers) but scoped to the needs of DE environment modelling. Capability modelling has moved to UAOS_DigitalEnvironment, which defines DEToolCapability, DEEnvironmentCapability, and DEProgramCapability as Disposition subclasses bearing on DETools, DigitalEnvironments, and EngineeringProgrammes respectively.</dc:description>
        <dc:hasVersion>0.3</dc:hasVersion>
    </owl:Ontology>
    


