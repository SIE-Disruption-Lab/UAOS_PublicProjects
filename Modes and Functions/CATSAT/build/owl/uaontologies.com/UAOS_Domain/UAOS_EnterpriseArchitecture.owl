    <!-- http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#hasComponentVersion -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#hasComponentVersion">
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#ApplicationComponent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:description>[=hasComponentVersion=] records the deployed version of an ApplicationComponent.</dc:description>
        <rdfs:label>has component version</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#isProprietary -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#isProprietary">
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#ApplicationComponent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <dc:description>[=isProprietary=] indicates whether an ApplicationComponent is proprietary software.</dc:description>
        <rdfs:label>is proprietary</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#ApplicationComponent -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#ApplicationComponent">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Object"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>An [=ApplicationComponent=] is a deployed instance of software in a specific organisational context — a particular, independent continuant (Object). Maps to ArchiMate &apos;Application Component&apos;. Modelled as tlo:Object rather than sw:Software because a deployment is a particular thing, not an abstract pattern: &apos;UA&apos;s installation of Jama Connect&apos; is an Object, whereas &apos;Jama Connect the product&apos; is a GDC (sw:Software). Being an Object (IndependentContinuant) makes ApplicationComponent a valid bearer for both SDCs (Functions, Dispositions) and GDCs.</dc:description>
        <rdfs:label>Application Component</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#ApplicationService -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#ApplicationService">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Function"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#sdo"/>
                <owl:someValuesFrom rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#ApplicationComponent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>An [=ApplicationService=] is a Function of an ApplicationComponent — the specific service behaviour the component exposes. Maps to ArchiMate &apos;Application Service&apos;. Ontologically: a SpecificallyDependentContinuant (Function/Disposition) inhering in an ApplicationComponent.</dc:description>
        <rdfs:label>Application Service</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#EngineeringProgramme -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#EngineeringProgramme">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Agent#Organization"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>An [=EngineeringProgramme=] is a collective Agent composed of two or more Organisations collaborating on a shared engineering endeavour. It is the bearer of DEProgramCapability dispositions (defined in UAOS_DigitalEnvironment) that emerge from the combined capabilities and integrations of its member organisations. Modelled as a subtype of agent:Organization.</dc:description>
        <rdfs:label>Engineering Programme</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#HasMemberOrganisation -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#HasMemberOrganisation">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasMemberOrganisation=] relates an EngineeringProgramme to each member Organisation that participates in it.</dc:description>
        <rdfs:label>Has Member Organisation</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#HostedOn -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#HostedOn">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HostedOn=] relates an ApplicationComponent to the TechnologyPlatform on which it runs.</dc:description>
        <rdfs:label>Hosted On</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#Provides -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#Provides">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=Provides=] relates an ApplicationComponent to an ApplicationService it implements and exposes. The BFO grounding is captured by the sdo restriction on ApplicationService (service spec is specifically dependent on the implementing component).</dc:description>
        <rdfs:label>Provides</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#TechnologyPlatform -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_EnterpriseArchitecture#TechnologyPlatform">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Object"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=TechnologyPlatform=] is a material Object that provides hosting or runtime services for ApplicationComponents (e.g., a cloud platform, an on-premise server cluster).</dc:description>
        <rdfs:label>Technology Platform</rdfs:label>
    </owl:Class>
    


