        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#PolicyRequirement"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#PolicyCorrection"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#ProposesCorrection"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>proposes correction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#qualityProfileOf -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#qualityProfileOf">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#hasQualityProfile"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#QualityProfile"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#ScoreVector"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#HasQualityProfile"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>quality profile of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#qualitySubCharacteristicOf -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#qualitySubCharacteristicOf">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#hasQualitySubCharacteristic"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#QualitySubCharacteristic"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#QualityProfile"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#HasQualitySubCharacteristic"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>quality sub-characteristic of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#regulatoryRequirementTracedToBy -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#regulatoryRequirementTracedToBy">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#tracesToRegulatoryRequirement"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#RegulatoryRequirement"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#GovernanceDomain"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#TracesToRegulatoryRequirement"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>regulatory requirement traced to by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#scoreVectorOf -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#scoreVectorOf">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#hasScoreVector"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#ScoreVector"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#AssessedElement"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#HasScoreVector"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>score vector of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#tracesToRegulatoryRequirement -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#tracesToRegulatoryRequirement">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#GovernanceDomain"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#RegulatoryRequirement"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#TracesToRegulatoryRequirement"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>traces to regulatory requirement</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#hasComplianceLevel -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#hasComplianceLevel">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#ScoreVector"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <dc:description>[=hasComplianceLevel=] records the numeric D3 governance compliance score within a ScoreVector, normalised to the applicable ComplianceScale.</dc:description>
        <rdfs:label>has compliance level</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#hasCorrectionRationale -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#hasCorrectionRationale">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#PolicyCorrection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:description>[=hasCorrectionRationale=] records the textual rationale explaining why a PolicyRequirement is antiquated and what the associated PolicyCorrection proposes to change.</dc:description>
        <rdfs:label>has correction rationale</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#hasEvidenceNumeric -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#hasEvidenceNumeric">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#EvidenceQualityCategory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <dc:description>[=hasEvidenceNumeric=] records the integer code of an EvidenceQualityCategory on the D1 scale (0-8). EQ-0 indicates no usable evidence; EQ-8 indicates the highest-quality operational evidence. Used with hasOrdinalPosition (defined in UAOS_GRL) for ordering and gap computations.</dc:description>
        <rdfs:label>has evidence numeric</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#hasFeasibilityRatio -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#hasFeasibilityRatio">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#FeasibilityGap"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <dc:description>[=hasFeasibilityRatio=] records the ratio of available resources to required resources for a FeasibilityGap. A ratio below 1.0 indicates that the programme does not have sufficient resources to meet its readiness ambition.</dc:description>
        <rdfs:label>has feasibility ratio</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#hasGapMagnitude -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#hasGapMagnitude">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#Gap"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <dc:description>[=hasGapMagnitude=] records the magnitude of a discrepancy identified by a Gap analysis process — the numeric difference between current state and target state on the relevant axis or layer.</dc:description>
        <rdfs:label>has gap magnitude</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#hasQualityScore -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#hasQualityScore">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#QualityProfile"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <dc:description>[=hasQualityScore=] records the aggregate numeric D4 quality score for a QualityProfile, computed as the median of all constituent QualitySubCharacteristic scores.</dc:description>
        <rdfs:label>has quality score</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#hasThresholdValue -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#hasThresholdValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#Gap"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <dc:description>[=hasThresholdValue=] records the threshold value defining when a gap is considered significant (e.g., a VerticalGap is flagged when the GRL score difference across adjacent layers exceeds this threshold).</dc:description>
        <rdfs:label>has threshold value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#isAntiquated -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#isAntiquated">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#PolicyRequirement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <dc:description>[=isAntiquated=] flags a PolicyRequirement as outdated or superseded — a policy no longer fit for purpose in the current regulatory environment. When true, a PolicyCorrection should be associated via ProposesCorrection.</dc:description>
        <rdfs:label>is antiquated</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#AssessedElement -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#AssessedElement">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Role"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>An [=AssessedElement=] is a Role borne by a material entity (system, subsystem, component, or capability) in the context of a 4D assessment — the role of &apos;being the entity under assessment&apos;. As a role, it is intentionally tool-agnostic (no Cameo, Jama, or vendor-specific subtypes). The bearer of this role has qualities (actual readiness, quality sub-characteristics) that are measured and recorded as ScoreVectors.</dc:description>
        <rdfs:label>Assessed Element</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#BindingConstraint -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#BindingConstraint">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#DescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=BindingConstraint=] is a DescriptiveICE that records the bottleneck finding from a 4D assessment — the single element, thread, or dimension that most constrains the overall readiness score, analogous to the constraint in Goldratt&apos;s Theory of Constraints. A BindingConstraint is a documented finding (information artifact) distinct from the bottleneck phenomenon itself. The overall programme GRL is bounded by its BindingConstraint.</dc:description>
        <rdfs:label>Binding Constraint</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#CapabilityThreadInstance -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#CapabilityThreadInstance">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Role"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=CapabilityThreadInstance=] is a Role borne by an AssessedElement in the context of a specific assessment thread — it is the role of &apos;being the T-thread participant&apos; (or P, I, H, O, K) for a given element in the framework hierarchy. As a role, it is a realizable entity that enables thread-level GRL scoring for each applicable dimension of readiness concern.</dc:description>
        <rdfs:label>Capability Thread Instance</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#ComplianceScale -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#ComplianceScale">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#DescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=ComplianceScale=] is a DescriptiveICE that specifies the scoring scale used by a GovernanceDomain to express compliance levels (e.g., binary yes/no, 5-point Likert, percentage 0-100). Each GovernanceDomain carries exactly one ComplianceScale so that D3 scores can be normalised across domains.</dc:description>
        <rdfs:label>Compliance Scale</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#DataOriginator -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#DataOriginator">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Role"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=DataOriginator=] is a Role borne by an agent that is responsible for creating and submitting the original assessment data for an AssessedElement. Distinct from DataOwner: the originator produces the data; the owner is accountable for it. Multiple originators may contribute to a single element&apos;s assessment.</dc:description>
        <rdfs:label>Data Originator</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#DataOwner -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#DataOwner">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Role"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=DataOwner=] is a Role borne by an agent that is responsible for the accuracy, currency, and governance of 4D assessment data for an AssessedElement. The DataOwner role confers accountability for the ScoreVector and its supporting evidence in the context of a specific assessment.</dc:description>
        <rdfs:label>Data Owner</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#DimensionalGap -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#DimensionalGap">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#Gap"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=DimensionalGap=] is a Gap analysis process that reveals a cross-dimension discrepancy in the ScoreVector — for example, a system scored high on D2 (GRL) but low on D1 (evidence quality), suggesting over-claimed readiness. Three canonical cross-dimension gaps are defined.</dc:description>
        <rdfs:label>Dimensional Gap</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#EvidenceQualityCategory -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#EvidenceQualityCategory">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#DescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>An [=EvidenceQualityCategory=] is a DescriptiveICE that represents one of the nine categories on the D1 evidence quality scale (EQ-0 through EQ-8). Categories are ordered ordinally by their evidenceNumeric and hasOrdinalPosition values (from UAOS_GRL). EQ-0 represents no usable evidence; EQ-8 represents the highest-quality operational evidence. The D1 scale is non-monotonic: evidence quality can regress. Canonical instances are defined in the UAOS_EvidenceCategories library description.</dc:description>
        <rdfs:label>Evidence Quality Category</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#FeasibilityGap -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#FeasibilityGap">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#StructuralGap"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=FeasibilityGap=] is a StructuralGap that reveals a mismatch between programme resource availability and the readiness ambition encoded in the assessment roadmap. Feasibility gaps apply the Goldratt Theory of Constraints lens to the programme resource-ambition ratio, flagging programmes where ambitions cannot be met with available resources.</dc:description>
        <rdfs:label>Feasibility Gap</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#FrameworkLayer -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#FrameworkLayer">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Role"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=FrameworkLayer=] is a Role borne by an AssessedElement in the context of the readiness roadmap hierarchy — it is the role of &apos;occupying level L&apos; (e.g., Mission, Capability, System, Subsystem) within the framework. As a role, it is a realizable entity that enables VerticalGap and HorizontalGap analysis across adjacent hierarchy levels.</dc:description>
        <rdfs:label>Framework Layer</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#Gap -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#Gap">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Process"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=Gap=] is a Process constituting a gap analysis — the comparison of current state against target state that reveals a discrepancy across dimensions, threads, or hierarchy layers. Gaps are processes because they unfold through assessment as discrepancies are discovered. The gap report that records the finding is a DescriptiveICE; the Gap class represents the analysis activity that produces it.</dc:description>
        <rdfs:label>Gap</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#GovernanceDomain -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#GovernanceDomain">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#PrescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=GovernanceDomain=] is a PrescriptiveICE that specifies a regulatory or governance domain applicable to an AssessedElement — for example, cybersecurity (RMF, CMMC), safety (MIL-STD-882), or acquisition policy (DoD 5000 series). Governance domains define the scope and compliance scale for D3 (GovernanceAxis) scoring. A GovernanceDomain carries its own ComplianceScale because different regulatory bodies use different scoring conventions.</dc:description>
        <rdfs:label>Governance Domain</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#HasBindingConstraint -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#HasBindingConstraint">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasBindingConstraint=] relates an AssessedElement to the BindingConstraint that identifies the bottleneck constraining its overall 4D readiness score per Theory of Constraints.</dc:description>
        <rdfs:label>Has Binding Constraint</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#HasCapabilityThreadInstance -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#HasCapabilityThreadInstance">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasCapabilityThreadInstance=] relates an AssessedElement to a CapabilityThreadInstance that binds a specific AssessmentThread to that element for thread-level GRL scoring.</dc:description>
        <rdfs:label>Has Capability Thread Instance</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#HasComplianceScale -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#HasComplianceScale">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasComplianceScale=] relates a GovernanceDomain to the ComplianceScale specifying how compliance with that domain is scored.</dc:description>
        <rdfs:label>Has Compliance Scale</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#HasEvidenceCategory -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#HasEvidenceCategory">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasEvidenceCategory=] relates a ScoreVector to the EvidenceQualityCategory recording its D1 evidence quality score. Exactly one EvidenceQualityCategory per ScoreVector.</dc:description>
        <rdfs:label>Has Evidence Category</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#HasGRLLevel -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#HasGRLLevel">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasGRLLevel=] relates a ScoreVector to the GRLLevel recording its D2 system readiness score. Exactly one GRLLevel per ScoreVector.</dc:description>
        <rdfs:label>Has GRL Level</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#HasGap -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#HasGap">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasGap=] relates an AssessedElement to a Gap analysis process that reveals a discrepancy in its 4D assessment. Gaps may be structural (Vertical, Horizontal, Feasibility) or dimensional (QualityReadiness, QualityEvidence, QualityCompliance).</dc:description>
        <rdfs:label>Has Gap</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#HasGovernanceDomain -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#HasGovernanceDomain">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasGovernanceDomain=] relates a TailoringSet to the GovernanceDomains it activates for a specific programme or assessment context.</dc:description>
        <rdfs:label>Has Governance Domain</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#HasQualityProfile -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#HasQualityProfile">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasQualityProfile=] relates a ScoreVector to the QualityProfile recording its D4 product/process quality score. Exactly one QualityProfile per ScoreVector.</dc:description>
        <rdfs:label>Has Quality Profile</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#HasQualitySubCharacteristic -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#HasQualitySubCharacteristic">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasQualitySubCharacteristic=] relates a QualityProfile to a QualitySubCharacteristic whose score is recorded within it. A profile may include scores for any applicable subset of ISO 25010 / ISO 25012 sub-characteristics.</dc:description>
        <rdfs:label>Has Quality Sub-Characteristic</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#HasScoreVector -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#HasScoreVector">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasScoreVector=] relates an AssessedElement to a ScoreVector that records its 4D assessment result. An element may accumulate multiple ScoreVectors over time (versioned assessments) or from different assessors, enabling trend analysis and assessor disagreement tracking.</dc:description>
        <rdfs:label>Has Score Vector</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#HorizontalGap -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#HorizontalGap">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#StructuralGap"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=HorizontalGap=] is a StructuralGap that reveals a readiness discrepancy within a single hierarchy layer — for example, elements at the same layer scored significantly differently across threads or assessors. Horizontal gaps indicate uneven readiness that may mask systemic weaknesses hidden by averaging.</dc:description>
        <rdfs:label>Horizontal Gap</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#InFamily -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#InFamily">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=InFamily=] relates a QualitySubCharacteristic to the QualityFamily that groups it per ISO 25010 / ISO 25012. Each sub-characteristic belongs to exactly one family.</dc:description>
        <rdfs:label>In Family</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#InFrameworkLayer -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#InFrameworkLayer">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=InFrameworkLayer=] relates a CapabilityThreadInstance to the FrameworkLayer it occupies in the readiness roadmap hierarchy, enabling vertical and horizontal gap analysis across layers.</dc:description>
        <rdfs:label>In Framework Layer</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#PolicyCorrection -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#PolicyCorrection">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#PrescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=PolicyCorrection=] is a PrescriptiveICE that documents a proposed correction to an antiquated PolicyRequirement — recording the rationale for the correction and the recommended updated requirement text. PolicyCorrections support D3 gap analysis by surfacing policy issues that distort compliance scores and cannot be resolved by the programme alone.</dc:description>
        <rdfs:label>Policy Correction</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#PolicyRequirement -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#PolicyRequirement">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#RegulatoryRequirement"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=PolicyRequirement=] is a RegulatoryRequirement that represents a specific policy mandate. PolicyRequirements carry an isAntiquated flag to support detection of outdated policy that may artificially inflate or depress D3 compliance scores. An antiquated PolicyRequirement should be accompanied by a PolicyCorrection documenting the proposed update.</dc:description>
        <rdfs:label>Policy Requirement</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#ProposesCorrection -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#ProposesCorrection">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=ProposesCorrection=] relates an antiquated PolicyRequirement to the PolicyCorrection documenting the proposed policy update.</dc:description>
        <rdfs:label>Proposes Correction</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#QualityComplianceGap -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#QualityComplianceGap">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#DimensionalGap"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=QualityComplianceGap=] is a DimensionalGap revealing a discrepancy between D4 (product quality) and D3 (governance compliance) scores — for example, high ISO product quality scores paired with inadequate regulatory compliance, suggesting that quality is achieved in ways that are not governance-compliant.</dc:description>
        <rdfs:label>Quality Compliance Gap</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#QualityEvidenceGap -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#QualityEvidenceGap">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#DimensionalGap"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=QualityEvidenceGap=] is a DimensionalGap revealing a discrepancy between D4 (product quality) and D1 (evidence quality) scores — for example, high quality sub-characteristic scores that are unsupported by adequate evidence, indicating that quality claims are asserted rather than demonstrated.</dc:description>
        <rdfs:label>Quality Evidence Gap</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#QualityFamily -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#QualityFamily">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#DescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=QualityFamily=] is a DescriptiveICE that groups related QualitySubCharacteristics under a named ISO 25010 / ISO 25012 family heading. Example families: Reliability, Usability, Performance Efficiency, Security, Maintainability, Portability, Functional Suitability.</dc:description>
        <rdfs:label>Quality Family</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#QualityProfile -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#QualityProfile">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#DescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=QualityProfile=] is a DescriptiveICE that records the D4 quality assessment result for an AssessedElement — a multi-attribute record of quality scores across applicable QualitySubCharacteristics aligned with ISO 25010 and ISO 25012. The aggregate D4 score is the median of constituent sub-characteristic scores (ordinal-valid and robust to outliers).</dc:description>
        <rdfs:label>Quality Profile</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#QualityReadinessGap -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#QualityReadinessGap">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#DimensionalGap"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=QualityReadinessGap=] is a DimensionalGap revealing a discrepancy between D4 (product quality) and D2 (system readiness/GRL) scores — for example, a GRL 7 claim accompanied by poor ISO quality sub-characteristic scores, suggesting that operational readiness is claimed without commensurate product quality.</dc:description>
        <rdfs:label>Quality Readiness Gap</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#QualitySubCharacteristic -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#QualitySubCharacteristic">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Quality"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=QualitySubCharacteristic=] is a Quality that inheres in the product or process being assessed. It represents one of the ISO 25010 / ISO 25012 quality attributes (e.g., Availability, Fault Tolerance, Operability, Confidentiality) at which D4 scoring is targeted. As a BFO Quality, it inheres in its bearer and cannot be separated from it — the QualityProfile records the measured value, not the quality itself.</dc:description>
        <rdfs:label>Quality Sub-Characteristic</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#RegulatoryRequirement -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#RegulatoryRequirement">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Requirements#Requirement"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=RegulatoryRequirement=] is a Requirement derived from a regulatory or policy mandate within a GovernanceDomain. Regulatory requirements are traceable to authoritative sources (statutes, directives, standards) and serve as the targets of D3 compliance scoring.</dc:description>
        <rdfs:label>Regulatory Requirement</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#ScoreVector -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#ScoreVector">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#DescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=ScoreVector=] is a DescriptiveICE that records the 4D assessment result for one AssessedElement as an ordered tuple a(x) = (d1, d2, d3, d4) across the four assessment axes. ScoreVectors are information content entities — they record the measurement result, distinct from the actual readiness quality inhering in the system. Multiple assessors may produce different ScoreVectors for the same element at the same time, enabling provenance tracking and assessor disagreement analysis.</dc:description>
        <rdfs:label>Score Vector</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#StructuralGap -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#StructuralGap">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#Gap"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=StructuralGap=] is a Gap analysis process that reveals a discrepancy in the hierarchical structure of the assessment framework — between layers (VerticalGap), within a layer (HorizontalGap), or between resource availability and programme ambition (FeasibilityGap).</dc:description>
        <rdfs:label>Structural Gap</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#TailoringSet -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#TailoringSet">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#PrescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=TailoringSet=] is a PrescriptiveICE that specifies the configuration of governance domains applicable to a particular programme or assessment context. The tailoring set identifies which GovernanceDomains are active and therefore which RegulatoryRequirements and ComplianceScales apply. Tailoring sets enable programme-specific D3 scoring without modifying the underlying governance domain specifications.</dc:description>
        <rdfs:label>Tailoring Set</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#TracesToRegulatoryRequirement -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#TracesToRegulatoryRequirement">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=TracesToRegulatoryRequirement=] relates a GovernanceDomain to the RegulatoryRequirements it imposes, establishing traceability from governance domain specification to specific policy mandates.</dc:description>
        <rdfs:label>Traces To Regulatory Requirement</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#VerticalGap -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#VerticalGap">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#StructuralGap"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=VerticalGap=] is a StructuralGap that reveals a readiness discrepancy between hierarchy layers — for example, a subsystem scored GRL 5 while the system it belongs to is claimed at GRL 7. Vertical gaps indicate that parent-level claims are not supported by child-level evidence and are detected by comparing GRL scores across adjacent FrameworkLayers.</dc:description>
        <rdfs:label>Vertical Gap</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Rules
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <rdf:Description rdf:about="urn:swrl:var#r">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="urn:swrl:var#s">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="urn:swrl:var#t">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description>
        <rdfs:label>hasBindingConstraint derivation</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#HasBindingConstraint"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://opencaesar.io/oml#hasSource"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#s"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://opencaesar.io/oml#hasTarget"/>
                                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                        <swrl:argument2 rdf:resource="urn:swrl:var#t"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#hasBindingConstraint"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                        <swrl:argument2 rdf:resource="urn:swrl:var#t"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <rdfs:label>hasCapabilityThreadInstance derivation</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#HasCapabilityThreadInstance"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://opencaesar.io/oml#hasSource"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#s"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://opencaesar.io/oml#hasTarget"/>
                                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                        <swrl:argument2 rdf:resource="urn:swrl:var#t"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#hasCapabilityThreadInstance"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                        <swrl:argument2 rdf:resource="urn:swrl:var#t"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <rdfs:label>inFrameworkLayer derivation</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#InFrameworkLayer"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://opencaesar.io/oml#hasSource"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#s"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://opencaesar.io/oml#hasTarget"/>
                                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                        <swrl:argument2 rdf:resource="urn:swrl:var#t"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#inFrameworkLayer"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                        <swrl:argument2 rdf:resource="urn:swrl:var#t"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <rdfs:label>proposesCorrection derivation</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
