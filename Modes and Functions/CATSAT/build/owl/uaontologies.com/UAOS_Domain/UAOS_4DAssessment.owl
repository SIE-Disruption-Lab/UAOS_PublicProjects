<?xml version="1.0"?>
<rdf:RDF xmlns="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#"
     xml:base="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:oml="http://opencaesar.io/oml#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:UAOS_4DAssessment="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#">
    <owl:Ontology rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment">
        <owl:imports rdf:resource="http://purl.org/dc/elements/1.1"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_GRL"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Requirements"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel"/>
        <oml:namespace rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_4DAssessment#"/>
        <oml:prefix>UAOS_4DAssessment</oml:prefix>
        <oml:type rdf:resource="http://opencaesar.io/oml#Vocabulary"/>
        <dc:contributor>Joe Gregory</dc:contributor>
        <dc:contributor>Paul Wach</dc:contributor>
        <dc:creator>SIE Disruption Lab</dc:creator>
        <dc:description>A vocabulary defining the 4D Assessment Framework — a multi-dimensional readiness scoring methodology that combines evidence quality (D1), system readiness via GRL (D2), governance compliance (D3), and product/process quality (D4) into a score vector a(x) = (d1, d2, d3, d4). Includes score vectors, governance domain and policy machinery, quality profiles and sub-characteristics, a structural and dimensional gap taxonomy, binding constraints per Theory of Constraints, and data provenance roles. Formalises the 4D framework from WRT-2516 Chapter 8.</dc:description>
        <dc:hasVersion>0.1</dc:hasVersion>
    </owl:Ontology>
    


