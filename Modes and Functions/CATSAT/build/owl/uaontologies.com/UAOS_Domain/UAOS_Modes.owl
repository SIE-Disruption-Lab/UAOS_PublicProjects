    <rdf:Description>
        <oml:name>http://uaontologies.com/UAOS_Domain/UAOS_Modes#TransitionAvailability</oml:name>
        <oml:type>http://opencaesar.io/oml#Rule</oml:type>
        <rdfs:comment>TRANSITION AVAILABILITY RULE: A Transition t is available in Mode m if t exits m. This rule derives availableIn for all Transitions from the state machine structure alone, making the state machine the single source of truth for transition availability. Non-transition Functions require explicit availableIn assertions. This rule, together with the HasSubTransition relation, enables structural checking of hierarchical mode transition completeness via SPARQL without any runtime state assertions.</rdfs:comment>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_States#exits"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#t"/>
                        <swrl:argument2 rdf:resource="urn:swrl:var#m"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:body>
