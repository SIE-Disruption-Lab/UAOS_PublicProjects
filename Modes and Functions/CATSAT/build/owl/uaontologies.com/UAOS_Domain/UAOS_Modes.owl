        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Modes#Mode"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Function"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Modes#AvailableIn"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>makes available</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Modes#specifiesExecutor -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Modes#specifiesExecutor">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Modes#FunctionalChainStep"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_SystemArchitecture#System"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Modes#SpecifiesExecutor"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>specifies executor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Modes#specifiesFunction -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Modes#specifiesFunction">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Modes#FunctionalChainStep"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Function"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Modes#SpecifiesFunction"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>specifies function</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Modes#hasSequencePosition -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Modes#hasSequencePosition">
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Modes#FunctionalChainStep"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <dc:description>[=hasSequencePosition=] assigns an integer execution position to a FunctionalChainStep within its parent FunctionalChain. Position 1 is the first step to be executed; steps are executed in ascending order of position.</dc:description>
        <rdfs:label>has sequence position</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Modes#AvailableIn -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Modes#AvailableIn">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=AvailableIn=] relates a Function to a Mode in which it is available for execution. A Function may be available in multiple Modes. For non-transition Functions this relation must be explicitly asserted by the modeller. For Transition instances (subclass of Function via UAOS_States), availableIn is automatically inferred by the TransitionAvailability rule from the state machine structure: if a Transition exits a Mode, it is available in that Mode. This unifies the state machine and the availability model under a single relation, with the state machine serving as the authoritative source for transition availability.</dc:description>
        <rdfs:label>AvailableIn</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Modes#FunctionalChain -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Modes#FunctionalChain">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#PrescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=FunctionalChain=] is a PrescriptiveICE — a specification prescribing an ordered sequence of function invocations to be performed by specific Systems. It corresponds to an On-Board Control Procedure (OBCP) as defined in ECSS-E-ST-70-11C. A FunctionalChain is a specification, not an execution: it exists independently of whether it has been or will be executed. Validity is assessed structurally: a FunctionalChain is valid if, for every FunctionalChainStep it contains, the specified Function is available in at least one Mode of the specified executing System. Steps that specify a Function not available in any Mode of the executor represent a structural error — the function can never be performed by that system regardless of its current mode.</dc:description>
        <rdfs:label>FunctionalChain</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Modes#FunctionalChainStep -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Modes#FunctionalChainStep">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#PrescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=FunctionalChainStep=] is a PrescriptiveICE that forms a single ordered step within a FunctionalChain. Each step specifies: (1) the Function to be performed, via specifiesFunction; (2) the System that should perform it, via specifiesExecutor; and (3) its position in the execution sequence, via hasSequencePosition. A FunctionalChainStep is a specification — it is not a FunctionOccurrence. Validity checking operates entirely at the disposition and specification level: the question is whether the specified Function is available in any Mode of the specified System, not whether the Function has been or is being executed.</dc:description>
        <rdfs:label>FunctionalChainStep</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Modes#HasStep -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Modes#HasStep">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasStep=] relates a FunctionalChain to its constituent FunctionalChainSteps. The set of steps, together with their hasSequencePosition values, fully defines the ordered specification of the chain.</dc:description>
        <rdfs:label>HasStep</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Modes#HasSubTransition -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Modes#HasSubTransition">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasSubTransition=] relates a parent-level Transition to a child-level Transition that must execute as part of the parent transition. This captures ECSS-E-ST-70-11C Table 5.2 Step 1b (Reconfiguring Lower Levels): when a System transitions to a new Mode, all lower-level elements it contains must also transition to their corresponding Modes, and each such child transition is a HasSubTransition of the parent. The completeness of the HasSubTransition hierarchy — specifically, that every parent Transition has a declared sub-transition for every child System — is the key structural invariant checked by Query 02. If a parent Transition lacks a sub-transition for some child System, the mode transition cannot complete, regardless of which mode the system is currently in.</dc:description>
        <rdfs:label>HasSubTransition</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Modes#Mode -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Modes#Mode">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_States#State"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#sdo"/>
                <owl:someValuesFrom rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_SystemArchitecture#System"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasContinuantPart"/>
                <owl:allValuesFrom rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Modes#Mode"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#isContinuantPartOf"/>
                <owl:allValuesFrom rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Modes#Mode"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=Mode=] is a kind of State that is specifically dependent on a System at a given level of the logical architecture (spacecraft, subsystem, or assembly). A Mode determines which Functions are available for execution by that System: only Functions declared as availableIn that Mode may be performed while the System occupies it. This formalises the ECSS-E-ST-70-11C definition: &apos;the operational state of a spacecraft, subsystem or payload in which certain functions can be performed&apos;. Note the distinction between Mode (system/subsystem/assembly level) and State (component level): components have States whose values are determined by the Mode of the parent assembly. Mode is modelled as a Disposition rather than a role or quality because, like all Dispositions, it inheres in a specific bearer (the System), is persistent (it holds until explicitly changed by a Transition), and is realisable (it is realised whenever the System is in that operational configuration).</dc:description>
        <rdfs:label>Mode</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Modes#SpecifiesExecutor -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Modes#SpecifiesExecutor">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=SpecifiesExecutor=] relates a FunctionalChainStep to the System that the step specifies should perform the Function. Combined with SpecifiesFunction and the AvailableIn relation, this enables structural validation: for a step to be structurally valid, the specified Function must be available in at least one Mode of the specified System.</dc:description>
        <rdfs:label>SpecifiesExecutor</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Modes#SpecifiesFunction -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Modes#SpecifiesFunction">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=SpecifiesFunction=] relates a FunctionalChainStep to the Function it specifies should be performed. Because this relation targets a Function (a Disposition), not a FunctionOccurrence (a Process), the specification is mode-checkable: validity reduces to asking whether the specified Function is available in at least one Mode of the specified executor.</dc:description>
        <rdfs:label>SpecifiesFunction</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Rules
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <rdf:Description rdf:about="urn:swrl:var#r">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="urn:swrl:var#s">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="urn:swrl:var#t">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="urn:swrl:var#m">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description>
        <rdfs:label>hasStep derivation</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Modes#HasStep"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://opencaesar.io/oml#hasSource"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#s"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://opencaesar.io/oml#hasTarget"/>
                                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                        <swrl:argument2 rdf:resource="urn:swrl:var#t"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Modes#hasStep"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                        <swrl:argument2 rdf:resource="urn:swrl:var#t"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <rdfs:label>hasSubTransition derivation</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
