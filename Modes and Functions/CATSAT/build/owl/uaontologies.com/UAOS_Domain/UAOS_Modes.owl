        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Function"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Modes#FunctionalChainStep"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Modes#SpecifiesFunction"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>is function specified by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Modes#isStepOf -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Modes#isStepOf">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Modes#hasStep"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Modes#FunctionalChainStep"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Modes#FunctionalChain"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Modes#HasStep"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>is step of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Modes#isSubTransitionOf -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Modes#isSubTransitionOf">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Modes#hasSubTransition"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_States#Transition"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_States#Transition"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Modes#HasSubTransition"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>is sub-transition of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Modes#makesAvailable -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Modes#makesAvailable">
