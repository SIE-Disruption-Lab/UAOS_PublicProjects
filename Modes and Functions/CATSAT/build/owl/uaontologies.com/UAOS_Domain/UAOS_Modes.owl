<?xml version="1.0"?>
<rdf:RDF xmlns="http://uaontologies.com/UAOS_Domain/UAOS_Modes#"
     xml:base="http://uaontologies.com/UAOS_Domain/UAOS_Modes"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:oml="http://opencaesar.io/oml#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:modes="http://uaontologies.com/UAOS_Domain/UAOS_Modes#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#">
    <owl:Ontology rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Modes">
        <owl:imports rdf:resource="http://purl.org/dc/elements/1.1"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_States"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_SystemArchitecture"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel"/>
        <oml:namespace rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Modes#"/>
        <oml:prefix>modes</oml:prefix>
        <oml:type rdf:resource="http://opencaesar.io/oml#Vocabulary"/>
        <dc:contributor>Joe Gregory</dc:contributor>
        <dc:creator>SIE Disruption Lab</dc:creator>
        <dc:description>A vocabulary capturing the Modes and Functions ontological pattern for spacecraft systems engineering. A Mode is a kind of State — a Disposition specifically dependent on a System — that determines which Functions are available for execution. A FunctionalChain is a specification (PrescriptiveICE) of an ordered sequence of function invocations; validity is checked structurally against the mode-function availability model, with no reference to runtime state. State machine transitions (Transition instances, already defined in UAOS_States as a subclass of Function) carry their availability in the mode they exit, derived by the TransitionAvailability rule. The HasSubTransition relation captures the hierarchical trigger requirement for reconfiguring lower-level elements during a mode transition — formalized here with reference to ECSS-E-ST-70-11C Table 5.2 Step 1b, but applicable wherever spacecraft or complex system behavior is organized around discrete operational states with hierarchical reconfiguration requirements. The vocabulary is standard-agnostic in structure: ECSS provides terminological grounding, not a constraint on applicability.</dc:description>
        <dc:hasVersion>0.2</dc:hasVersion>
    </owl:Ontology>
    


