        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_SystemArchitecture#System"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Modes#FunctionalChainStep"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Modes#SpecifiesExecutor"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>is executor specified by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Modes#isFunctionSpecifiedBy -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Modes#isFunctionSpecifiedBy">
