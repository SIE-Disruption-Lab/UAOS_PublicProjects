<?xml version="1.0"?>
<rdf:RDF xmlns="http://uaontologies.com/UAOS_Domain/UAOS_TEMP#"
     xml:base="http://uaontologies.com/UAOS_Domain/UAOS_TEMP"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:oml="http://opencaesar.io/oml#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:UAOS_TEMP="http://uaontologies.com/UAOS_Domain/UAOS_TEMP#">
    <owl:Ontology rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_TEMP">
        <owl:imports rdf:resource="http://purl.org/dc/elements/1.1"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Agent"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Assessment"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Requirements"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Test"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Verification"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel"/>
        <oml:namespace rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_TEMP#"/>
        <oml:prefix>UAOS_TEMP</oml:prefix>
        <oml:type rdf:resource="http://opencaesar.io/oml#Vocabulary"/>
        <dc:contributor>Joe Gregory</dc:contributor>
        <dc:contributor>Paul Wach</dc:contributor>
        <dc:creator>SIE Disruption Lab</dc:creator>
        <dc:description>A vocabulary defining the Test and Evaluation Master Plan (TEMP) framework — the overarching T&amp;E planning document, its lifecycle phases (Developmental, Operational, Live Fire), test articles, resource requirements, milestones, and evidence produced. Formalises TEMP structure per DoD Instruction 5000.89 (Test and Evaluation, 2020) and the DAU Test and Evaluation Master Plan Guidebook (2021). Part of the 4D Assessment ontology family.</dc:description>
        <dc:hasVersion>0.1</dc:hasVersion>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_TEMP#TestMissionType -->


    <rdfs:Datatype rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_TEMP#TestMissionType">
        <dc:description>[=TestMissionType=] enumerates the mission classification types applicable to a TestProcedure, corresponding to the SysML MissionType enum.</dc:description>
        <rdfs:label>Test Mission Type</rdfs:label>
        <owl:equivalentClass>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>AFTD Flight Test</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>Other</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </owl:equivalentClass>
    </rdfs:Datatype>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_TEMP#TestPhase -->


    <rdfs:Datatype rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_TEMP#TestPhase">
        <dc:description>[=TestPhase=] enumerates the three mission-sequence positions a TestProcedure can occupy, corresponding to the SysML Stage enum: Preflight, Execution, and Postflight.</dc:description>
        <rdfs:label>Test Phase</rdfs:label>
        <owl:equivalentClass>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>Execution</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>Postflight</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>Preflight</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </owl:equivalentClass>
    </rdfs:Datatype>
    


