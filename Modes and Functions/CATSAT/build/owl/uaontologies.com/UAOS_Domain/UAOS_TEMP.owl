        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_TEMP#HasPlannedTestSubject"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>has planned test subject</rdfs:label>
    </owl:ObjectProperty>
    


