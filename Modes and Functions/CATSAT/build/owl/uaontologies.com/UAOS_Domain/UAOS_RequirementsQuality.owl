        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#RequirementSet"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#MemberOfSet"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>member of set</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#testsCharacteristic -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#testsCharacteristic">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#Rule"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#QualityCharacteristic"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#TestsCharacteristic"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>tests characteristic</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#violationConcerns -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#violationConcerns">
        <rdfs:subPropertyOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#describes"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#Violation"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#Requirement"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#ViolationConcerns"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>violation concerns</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#violationOf -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#violationOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#Violation"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#Rule"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#ViolationOf"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>violation of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#hasAffectedText -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#hasAffectedText">
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#Violation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:description>[=hasAffectedText=] records the verbatim text segment within a Requirement statement that is the immediate locus of a Violation.</dc:description>
        <rdfs:label>has affected text</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#hasCharacteristicId -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#hasCharacteristicId">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#QualityCharacteristic"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:description>[=hasCharacteristicId=] records the canonical identifier of a QualityCharacteristic as assigned in INCOSE Guide V4 (e.g., &apos;C1&apos;, &apos;C15&apos;).</dc:description>
        <rdfs:label>has characteristic ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#hasOrdinalRank -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#hasOrdinalRank">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#SeverityRating"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <dc:description>[=hasOrdinalRank=] records the ordinal position of a SeverityRating on the Low–Critical scale (1 = Low, 2 = Medium, 3 = High, 4 = Critical).</dc:description>
        <rdfs:label>has ordinal rank</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#hasRequirementId -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#hasRequirementId">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#Requirement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:description>[=hasRequirementId=] records the project-assigned identifier of a Requirement (e.g., &apos;SYS-REQ-001&apos;).</dc:description>
        <rdfs:label>has requirement ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#hasRuleId -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#hasRuleId">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#Rule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:description>[=hasRuleId=] records the canonical identifier of a Rule as assigned in INCOSE Guide V4 (e.g., &apos;R1&apos;, &apos;R42&apos;).</dc:description>
        <rdfs:label>has rule ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#hasStatementText -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#hasStatementText">
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#Requirement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:description>[=hasStatementText=] records the full natural-language text of a Requirement statement.</dc:description>
        <rdfs:label>has statement text</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#requiresProjectDictionary -->


    <owl:DatatypeProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#requiresProjectDictionary">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#Rule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <dc:description>[=requiresProjectDictionary=] indicates whether application of a Rule requires a project-specific glossary or data dictionary to be in place. Derived from INCOSE Guide V4 Appendix D.</dc:description>
        <rdfs:label>requires project dictionary</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#AssessesSet -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#AssessesSet">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=AssessesSet=] relates an Assessment to a RequirementSet that is being evaluated. An Assessment may cover more than one set.</dc:description>
        <rdfs:label>Assesses Set</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#Assessment -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#Assessment">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Agent#ManagedProcess"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>An [=Assessment=] is a ManagedProcess in which a RequirementSet is systematically evaluated against the applicable Rules to identify Violations. The Assessment is conducted by one or more Agents (hasAssessor) over a TemporalRegion (hasAssessmentPeriod) and produces exactly one AssessmentResult.</dc:description>
        <rdfs:label>Assessment</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#AssessmentResult -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#AssessmentResult">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#DescriptiveICE"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasContinuantPart"/>
                <owl:someValuesFrom rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#Violation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>An [=AssessmentResult=] is a DescriptiveICE recording the outcome of an Assessment. It is formally about the assessed RequirementSet (via AssessmentResultAbout, a sub-relation of info:IsAbout) and carries zero or more Violations as ICE parts (restricts some tlo:hasContinuantPart to Violation). The IE-Inherits-Representation rule in UAOS_Information then propagates: all Violation parts inherit the AssessmentResult&apos;s aboutness of the RequirementSet.</dc:description>
        <rdfs:label>Assessment Result</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#AssessmentResultAbout -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#AssessmentResultAbout">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#IsAbout"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=AssessmentResultAbout=] relates an AssessmentResult directly to the RequirementSet it covers. Sub-relation of info:IsAbout, enabling direct queries of &apos;what set does this result describe?&apos; without traversing the Assessment process. Functional because each AssessmentResult covers the set assessed in its parent Assessment. The IE-Inherits-Representation rule then propagates this aboutness to all Violation parts of the result.</dc:description>
        <rdfs:label>Assessment Result About</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#BelongsToCategory -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#BelongsToCategory">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=BelongsToCategory=] relates a Rule to the RuleCategory under which it is grouped. Each Rule belongs to exactly one category.</dc:description>
        <rdfs:label>Belongs To Category</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#HasApplicability -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#HasApplicability">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasApplicability=] relates a Rule to its RuleApplicability level, indicating whether the rule is compulsory or recommended at the need and requirement levels. Derived from INCOSE Guide V4 Appendix D.</dc:description>
        <rdfs:label>Has Applicability</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#HasAssessmentPeriod -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#HasAssessmentPeriod">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasAssessmentPeriod=] relates an Assessment to the TemporalRegion over which it was conducted. Begin and end instants are recorded on the TemporalRegion via tlo:hasBeginInstant and tlo:hasEndInstant.</dc:description>
        <rdfs:label>Has Assessment Period</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#HasAssessmentResult -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#HasAssessmentResult">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasAssessmentResult=] relates an Assessment to its AssessmentResult. Each Assessment produces exactly one result.</dc:description>
        <rdfs:label>Has Assessment Result</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#HasAssessor -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#HasAssessor">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasAssessor=] relates an Assessment to the Agent (Person or Organisation) conducting it. An assessment may have more than one assessor.</dc:description>
        <rdfs:label>Has Assessor</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#HasSeverityRating -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#HasSeverityRating">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasSeverityRating=] relates a Violation to its SeverityRating on the Low–Critical ordinal scale.</dc:description>
        <rdfs:label>Has Severity Rating</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#IndividualQualityCharacteristic -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#IndividualQualityCharacteristic">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#QualityCharacteristic"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>An [=IndividualQualityCharacteristic=] is a QualityCharacteristic that applies to a single Requirement in isolation. The nine individual characteristics (C1 Necessary through C9 Conforming) each define a quality that any well-formed individual requirement should exhibit.</dc:description>
        <rdfs:label>Individual Quality Characteristic</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#MemberOfSet -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#MemberOfSet">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=MemberOfSet=] relates a Requirement to a RequirementSet of which it is a member. A Requirement may belong to more than one set.</dc:description>
        <rdfs:label>Member Of Set</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#QualityCharacteristic -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#QualityCharacteristic">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#DescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=QualityCharacteristic=] is a DescriptiveICE naming a property that a well-formed Requirement or RequirementSet should exhibit. Characteristics are partitioned into individual (C1–C9) and set (C10–C15) subtypes. Defined in INCOSE Guide V4 Sections 2 and 3.</dc:description>
        <rdfs:label>Quality Characteristic</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#Requirement -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#Requirement">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#PrescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=Requirement=] is a PrescriptiveICE stating a capability, constraint, or quality factor that a system shall satisfy. It is the atomic unit of quality assessment in the INCOSE Guide V4 framework. A Requirement is a GDC: it is concretised in a document or tool artefact and may migrate between carriers while remaining the same requirement.</dc:description>
        <rdfs:label>Requirement</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#RequirementSet -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#RequirementSet">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#InformationContentEntity"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=RequirementSet=] is an InformationContentEntity grouping a cohesive collection of Requirements. RequirementSet is the unit submitted to an Assessment. Corresponds to the &apos;requirement set&apos; defined in INCOSE Guide V4 Section 3, against which set-level quality characteristics (C10–C15) are evaluated.</dc:description>
        <rdfs:label>Requirement Set</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#Rule -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#Rule">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#PrescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=Rule=] is a PrescriptiveICE prescribing a specific writing practice that requirement authors should apply to produce well-formed requirements. Each Rule belongs to exactly one RuleCategory, has exactly one RuleApplicability level, and tests one or more QualityCharacteristics. The 42 canonical Rules are defined in INCOSE Guide V4 Section 4, with applicability in Appendix D and characteristic cross-references in Appendix E.</dc:description>
        <rdfs:label>Rule</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#RuleApplicability -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#RuleApplicability">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#DescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=RuleApplicability=] is a DescriptiveICE representing one of three applicability levels from INCOSE Guide V4 Appendix D: CNCR (Compulsory for Needs and Compulsory for Requirements), RNCR (Recommended for Needs and Compulsory for Requirements), or CR (Compulsory for Requirements, optional for Needs).</dc:description>
        <rdfs:label>Rule Applicability</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#RuleCategory -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#RuleCategory">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#DescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=RuleCategory=] is a DescriptiveICE grouping related Rules under a common linguistic or structural concern (e.g., Accuracy, Non-Ambiguity, Singularity). The 14 canonical categories are defined in INCOSE Guide V4 Section 4.</dc:description>
        <rdfs:label>Rule Category</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#SetQualityCharacteristic -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#SetQualityCharacteristic">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#QualityCharacteristic"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=SetQualityCharacteristic=] is a QualityCharacteristic that applies to a RequirementSet as a whole. The six set characteristics (C10 Complete through C15 Correct) capture emergent properties of a collection that cannot be assessed at the level of individual requirements.</dc:description>
        <rdfs:label>Set Quality Characteristic</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#SeverityRating -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#SeverityRating">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#DescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=SeverityRating=] is a DescriptiveICE representing a level on an ordinal scale indicating the impact of a Violation. The canonical scale has four levels: Low (rank 1), Medium (rank 2), High (rank 3), Critical (rank 4). The ordinal position is captured by hasOrdinalRank.</dc:description>
        <rdfs:label>Severity Rating</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#TestsCharacteristic -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#TestsCharacteristic">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=TestsCharacteristic=] relates a Rule to a QualityCharacteristic that application of the rule helps to achieve or verify. Derived from INCOSE Guide V4 Appendix E cross-reference matrix. A rule may test multiple characteristics.</dc:description>
        <rdfs:label>Tests Characteristic</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#Violation -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#Violation">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#DescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=Violation=] is a DescriptiveICE recording the finding that a specific Requirement fails to satisfy a specific Rule. As a DescriptiveICE it is a judgment about a requirement — not a property inhering in it — which is the ontologically correct model given that Requirement is a GDC (not an SDCCarrier). The Violation concerns a Requirement via ViolationConcerns (a sub-relation of info:Describes) and cites the breached Rule via ViolationOf.</dc:description>
        <rdfs:label>Violation</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#ViolationConcerns -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#ViolationConcerns">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#Describes"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=ViolationConcerns=] relates a Violation to the Requirement it concerns. Sub-relation of info:Describes, expressing that a Violation is a description (a quality finding) about a specific Requirement. This replaces the inheresInRequirement object property of the source ontology: a Violation does not inhere in a Requirement — it describes it as having a defect. Each Violation concerns exactly one Requirement.</dc:description>
        <rdfs:label>Violation Concerns</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#ViolationOf -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#ViolationOf">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=ViolationOf=] relates a Violation to the Rule that was breached. Each Violation is a finding against exactly one Rule.</dc:description>
        <rdfs:label>Violation Of</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Rules
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <rdf:Description rdf:about="urn:swrl:var#r">
