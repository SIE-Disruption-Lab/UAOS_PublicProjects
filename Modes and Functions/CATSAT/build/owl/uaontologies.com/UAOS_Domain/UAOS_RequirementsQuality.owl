<?xml version="1.0"?>
<rdf:RDF xmlns="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#"
     xml:base="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:oml="http://opencaesar.io/oml#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:UAOS_RequirementsQuality="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#">
    <owl:Ontology rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality">
        <owl:imports rdf:resource="http://purl.org/dc/elements/1.1"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Agent"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel"/>
        <oml:namespace rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_RequirementsQuality#"/>
        <oml:prefix>UAOS_RequirementsQuality</oml:prefix>
        <oml:type rdf:resource="http://opencaesar.io/oml#Vocabulary"/>
        <dc:contributor>Joe Gregory</dc:contributor>
        <dc:creator>SIE Disruption Lab</dc:creator>
        <dc:description>A vocabulary formalising the INCOSE Guide to Writing Requirements V4 (2023) quality framework. Captures the 42 writing rules, 15 quality characteristics (9 individual, 6 set), 14 rule categories, severity ratings, and applicability levels, together with the Assessment process pattern for evaluating requirement sets against these rules. Source ontology: incose-req.ttl (Arizona SIE lab, v0.1.0). Departure from source: Violation was originally modelled as a BFO SDC inhering in a Requirement. This vocabulary rejects that choice because Requirement is a GDC, and GDCs are not SDCCarriers in UAOS — making the inheres-in relation a category error. Violation is re-modelled as a DescriptiveICE, with ViolationConcerns (a sub-relation of info:Describes) expressing the intentional relation to the Requirement it concerns.</dc:description>
        <dc:hasVersion>0.1</dc:hasVersion>
    </owl:Ontology>
    


