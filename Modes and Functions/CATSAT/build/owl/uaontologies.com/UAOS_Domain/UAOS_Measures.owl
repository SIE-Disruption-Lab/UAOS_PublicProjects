        <rdfs:label>measurement result of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Measures#AddressedByCOI -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Measures#AddressedByCOI">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=AddressedByCOI=] relates a COI to the MeasurementSpecification that addresses it — the COI is answered by examining results of a specific MOS, MOE, or MOP.</dc:description>
        <rdfs:label>AddressedByCOI</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Measures#COI -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Measures#COI">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#PrescriptiveICE"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=COI=] (Critical Operational Issue) is a PrescriptiveICE that poses a specific, testable question whose answer is necessary to evaluate mission suitability or effectiveness. COIs structure the evaluation framework by identifying what must be determined through analysis or test; they are addressed by examining MeasurementSpecifications.</dc:description>
        <rdfs:label>COI</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Measures#ContributesToMOE -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Measures#ContributesToMOE">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=ContributesToMOE=] relates a MOP to the MOE it contributes evidence toward — the performance measurement is a constituent indicator for the higher-level effectiveness measure.</dc:description>
        <rdfs:label>ContributesToMOE</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Measures#ContributesToMOS -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Measures#ContributesToMOS">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=ContributesToMOS=] relates an MOE to the MOS it contributes evidence toward — the effectiveness measurement is a constituent indicator for the higher-level suitability measure.</dc:description>
        <rdfs:label>ContributesToMOS</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Measures#EvaluatedBy -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Measures#EvaluatedBy">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=EvaluatedBy=] relates a Mission to a MeasurementSpecification (MOS, MOE, or MOP) used to evaluate it.</dc:description>
        <rdfs:label>EvaluatedBy</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Measures#HasCOI -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Measures#HasCOI">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasCOI=] relates a Mission to a Critical Operational Issue that must be resolved to assess the mission&apos;s suitability or effectiveness.</dc:description>
        <rdfs:label>HasCOI</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Measures#HasConstraint -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Measures#HasConstraint">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasConstraint=] relates a MeasurementSpecification to a req:Constraint that sets the threshold or pass-fail criterion for that measure — specifying the value boundary against which an actual measurement result is judged. The Constraint may be further represented mathematically by a req:ConstraintExpression (which carries the value, unit, and comparison operator). This relation provides the traceability link between the measurement framework (MOS/MOE/MOP) and the requirements framework (req:Constraint).</dc:description>
        <rdfs:label>HasConstraint</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Measures#HasMeasurementResult -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Measures#HasMeasurementResult">
        <oml:type rdf:resource="http://opencaesar.io/oml#RelationEntity"/>
        <dc:description>[=HasMeasurementResult=] relates a MeasurementSpecification to a meas:Measurement that is the result of executing the measurement criterion — connecting the prescriptive specification to an actual observed datum. Uses meas:Measurement (from UAOS_Measurement) which carries the value via meas:hasValue and relates to the measured Quantity via meas:measurementOf.</dc:description>
        <rdfs:label>HasMeasurementResult</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Measures#MOE -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Measures#MOE">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Measures#MeasurementSpecification"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>An [=MOE=] (Measure of Effectiveness) is a MeasurementSpecification that prescribes a criterion for evaluating the degree to which a mission achieves its intended operational objectives — assessing whether the right effects are produced. MOEs are informed by MOPs and contribute to MOS. Reference: DoD MEG v2.</dc:description>
        <rdfs:label>MOE</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Measures#MOP -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Measures#MOP">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Measures#MeasurementSpecification"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=MOP=] (Measure of Performance) is a MeasurementSpecification that prescribes a criterion for evaluating the technical or behavioural performance of a specific system function or activity. MOP is the lowest level in the hierarchy; results contribute to MOEs. Reference: DoD MEG v2.</dc:description>
        <rdfs:label>MOP</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Measures#MOS -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Measures#MOS">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Measures#MeasurementSpecification"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=MOS=] (Measure of Suitability) is a MeasurementSpecification that prescribes a criterion for evaluating whether a system or solution is suitable for operational use — assessing factors such as maintainability, supportability, logistics, and human factors. MOS sits at the top of the DoD MOS/MOE/MOP hierarchy and aggregates evidence from MOEs. Reference: DoD MEG v2.</dc:description>
        <rdfs:label>MOS</rdfs:label>
    </owl:Class>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Measures#MeasurementSpecification -->


    <owl:Class rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Measures#MeasurementSpecification">
        <rdfs:subClassOf rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#PrescriptiveICE"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information#prescribes"/>
                <owl:someValuesFrom rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Quantity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oml:type rdf:resource="http://opencaesar.io/oml#Concept"/>
        <dc:description>A [=MeasurementSpecification=] is a PrescriptiveICE that prescribes a measurement criterion — specifying what Quantity is to be observed, how it is to be quantified, and the threshold or target value constituting success. Subtypes: MOS (suitability), MOE (effectiveness), MOP (performance). Generically dependent — exists as a specification independent of any specific measurement event. Actual measurement results are captured as meas:Measurement instances linked via HasMeasurementResult.</dc:description>
        <rdfs:label>MeasurementSpecification</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Rules
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <rdf:Description rdf:about="urn:swrl:var#r">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="urn:swrl:var#s">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="urn:swrl:var#t">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description>
        <rdfs:label>contributesToMOE derivation</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
