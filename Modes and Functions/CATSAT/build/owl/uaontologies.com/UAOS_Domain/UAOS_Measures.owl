        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Measures#MeasurementSpecification"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement#Measurement"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Measures#HasMeasurementResult"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
