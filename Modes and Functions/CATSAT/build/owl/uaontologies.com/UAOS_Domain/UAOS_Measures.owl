        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_MissionEngineering#Mission"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Measures#COI"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Measures#HasCOI"/>
