<?xml version="1.0"?>
<rdf:RDF xmlns="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#"
     xml:base="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:oml="http://opencaesar.io/oml#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:UAOS_Lifecycle="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#">
    <owl:Ontology rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle">
        <owl:imports rdf:resource="http://purl.org/dc/elements/1.1"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Information"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Measurement"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Core/UAOS_Types"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_DigitalEnvironment"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_SystemArchitecture"/>
        <owl:imports rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel"/>
        <oml:namespace rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#"/>
        <oml:prefix>UAOS_Lifecycle</oml:prefix>
        <oml:type rdf:resource="http://opencaesar.io/oml#Vocabulary"/>
        <dc:contributor>Joe Gregory</dc:contributor>
        <dc:creator>SIE Disruption Lab</dc:creator>
        <dc:description>A vocabulary formalising the four-level NNSA physical hierarchy (System → Subsystem → Component → Part), condition-dependent life estimation (TypeLifeEstimate as a types:Estimate), discrete exposure history (ExposureEvent accumulating damage fractions for Miner&apos;s rule SPARQL), and context-dependent replaceability (isReplaceable asserted per physical instance). Type/token pattern is handled via UAOS_Types: part types are modelled as ObjectType instances, conformance via the Types relation, and TypeLifeEstimates are linked to QuantityType instances (ExpectedLife per condition) via estimateOf. The SWRL rule in UAOS_Types infers estimateOfQuantity across the type/token gap. System remaining-life aggregation: worst-case remaining life across non-replaceable parts propagates up the hierarchy.</dc:description>
        <dc:hasVersion>0.1</dc:hasVersion>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#appliesToCondition -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#appliesToCondition">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#TypeLifeEstimate"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#LifeConditionProfile"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#AppliesToCondition"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>applies to condition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#hadExposure -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#hadExposure">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#isExposureOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#Object"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#ExposureEvent"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#IsExposureOf"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>had exposure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#hasComponent -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#hasComponent">
        <rdfs:subPropertyOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasContinuantPart"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#Subsystem"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#Component"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#HasComponent"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>has component</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#hasPart -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#hasPart">
        <rdfs:subPropertyOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasContinuantPart"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#Component"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#Part"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#HasPart"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>has part</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#hasSubsystem -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#hasSubsystem">
        <rdfs:subPropertyOf rdf:resource="http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#hasContinuantPart"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_SystemArchitecture#System"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#Subsystem"/>
        <oml:relationEntity rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#HasSubsystem"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ForwardRelation"/>
        <rdfs:label>has subsystem</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#isComponentOf -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#isComponentOf">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#hasComponent"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#Component"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#Subsystem"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#HasComponent"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>is component of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#isConditionOfExposure -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#isConditionOfExposure">
        <owl:inverseOf rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#underCondition"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#LifeConditionProfile"/>
        <rdfs:range rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#ExposureEvent"/>
        <oml:relationBase rdf:resource="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#UnderCondition"/>
        <oml:type rdf:resource="http://opencaesar.io/oml#ReverseRelation"/>
        <rdfs:label>is condition of exposure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#isConditionOfLifeEstimate -->


    <owl:ObjectProperty rdf:about="http://uaontologies.com/UAOS_Domain/UAOS_Lifecycle#isConditionOfLifeEstimate">
