@dc:creator "SIE Disruption Lab"
@dc:contributor "Joe Gregory"
@dc:contributor "Ahmed Alhamadah"
@dc:description "A vocabulary to capture simple use case patterns"
@dc:hasVersion "0.1"
vocabulary <http://uaontologies.com/UAOS_Domain/UAOS_UseCases#> as UAOS_UseCases {
	
	////////////////////////////////////////////////////////////////////////////////////
	
	/////// Vocabulary Imports ///////
	
	// Import standard vocabularies	
    extends <http://purl.org/dc/elements/1.1/> as dc
    extends <http://www.w3.org/2000/01/rdf-schema#> as rdfs
    //extends <http://www.w3.org/2001/XMLSchema#> as xsd
    
    // Import relevant vocabularies
    extends <http://uaontologies.com/UAOS_TopLevel/UAOS_TopLevel#> as tlo
	extends <http://uaontologies.com/UAOS_Core/UAOS_Information#> as info
	extends <http://uaontologies.com/UAOS_Domain/UAOS_Requirements#> as req
	
	///////////////////////////////////////////////////////////////////////////////////
	
	
	/////// Vocabulary Definitions ///////
	
	///// Aspects
	
			
	
	///// Concepts
	
	@rdfs:label "Use Case"
	@dc:description "A [=Use Case=] is a..."
	concept UseCase < info:PrescriptiveICE [
		restricts all tlo:hasContinuantPart to UseCase
		restricts all tlo:isContinuantPartOf to UseCase
	]
	
	
	
	///// Relations
	
	@rdfs:label "Has Actor"
	@dc:description "[=HasActor=] is a..."
	relation entity HasActor [
		from UseCase
		to tlo:Continuant
		@rdfs:label "has actor"
		forward hasActor
		@rdfs:label "is actor in use case"
		reverse isActorInUseCase
		asymmetric
		irreflexive
	]
	
	relation entity Elicits [
		from UseCase
		to req:Requirement
		forward elicits
		reverse elicitedBy
		irreflexive
		asymmetric
	]
	
	relation entity ExtendsUseCase [
		from UseCase
		to UseCase
		forward extendsUseCase
		reverse useCaseExtendedBy
		irreflexive
		asymmetric
	]
	
	relation entity Involves [
		from UseCase
		to tlo:MaterialEntity
		forward involves
		reverse involvedIn
		irreflexive
		asymmetric
	]
	
	
	
	
	///// Scalar Properties
	

	
	
	///// Rules
		
	
}